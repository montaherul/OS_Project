@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-user-edit me-2"></i>Edit User</h2>
        <small class="text-muted">@Model.Email</small>
    </div>
    <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form method="post" asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="CurrentRole" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">First Name</label>
                            <input asp-for="FirstName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Last Name</label>
                            <input asp-for="LastName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <input asp-for="Email" class="form-control" type="email" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Status</label>
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <hr />
                            <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Save Changes</button>
                            <a asp-action="Details" asp-route-id="@Model.UserId" class="btn btn-outline-secondary ms-2">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>User Info</h6></div>
            <div class="card-body">
                <p class="mb-1"><small class="text-muted">User ID</small></p>
                <p><code style="font-size:11px;">@Model.UserId</code></p>
                <p class="mb-1"><small class="text-muted">Current Role</small></p>
                <p><span class="badge @(Model.CurrentRole == "Admin" ? "bg-danger" : "bg-primary")">@Model.CurrentRole</span></p>
            </div>
        </div>
    </div>
</div>
