@page
@model EDFRR.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center animate-in" style="margin-top:60px;">
    <div class="col-md-5 col-lg-4">
        <div class="card-edfrr">
            <div class="card-edfrr__body" style="padding:var(--space-6);">
                <div class="text-center mb-4">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:8px;">
                        <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/>
                        <line x1="12" y1="22" x2="12" y2="15.5"/>
                        <polyline points="22 8.5 12 15.5 2 8.5"/>
                    </svg>
                    <h5 style="font-weight:600;">Welcome Back</h5>
                    <p style="font-size:13px;color:var(--text-muted);">Sign in to your EDFRR account</p>
                </div>

                <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:12px;"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="edfrr-label">Email</label>
                        <input asp-for="Input.Email" class="edfrr-input" autocomplete="username" placeholder="Enter your email" />
                        <span asp-validation-for="Input.Email" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="edfrr-label">Password</label>
                        <input asp-for="Input.Password" class="edfrr-input" autocomplete="current-password" placeholder="Enter your password" />
                        <span asp-validation-for="Input.Password" class="text-danger" style="font-size:11px;"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label" style="font-size:13px;">Remember me</label>
                    </div>

                    <button type="submit" class="btn-primary w-100">
                        <i class="fas fa-sign-in-alt me-1"></i> Sign In
                    </button>
                </form>

                <div style="border-top:1px solid var(--border-subtle);margin-top:var(--space-4);padding-top:var(--space-4);text-align:center;">
                    <p style="font-size:13px;color:var(--text-muted);margin:0;">
                        Don't have an account? <a asp-area="Identity" asp-page="/Account/Register" style="color:var(--color-primary);font-weight:500;">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
