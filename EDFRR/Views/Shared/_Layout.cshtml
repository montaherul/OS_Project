@using Microsoft.AspNetCore.Identity
@inject SignInManager<EDFRR.Models.Entities.ApplicationUser> SignInManager
@inject UserManager<EDFRR.Models.Entities.ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var isAdminArea = area == "Admin";
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EDFRR</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/edfrr-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/edfrr-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/edfrr-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/edfrr-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EDFRR.styles.css" asp-append-version="true" />
</head>
<body class="edfrr-body">
    <!-- Top Navigation -->
    <nav class="topnav">
        <a class="topnav__logo" asp-area="" asp-controller="Home" asp-action="Index">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/>
                <line x1="12" y1="22" x2="12" y2="15.5"/>
                <polyline points="22 8.5 12 15.5 2 8.5"/>
            </svg>
            EDFRR
        </a>

        <div class="topnav__links">
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="topnav__link @(controller == "Dashboard" ? "active" : "")"
                   asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt me-1"></i><span>Dashboard</span>
                </a>
                <a class="topnav__link @(controller == "Simulation" ? "active" : "")"
                   asp-area="" asp-controller="Simulation" asp-action="Index">
                    <i class="fas fa-play-circle me-1"></i><span>Simulate</span>
                </a>
                <a class="topnav__link @(controller == "SchedulerComparison" ? "active" : "")"
                   asp-area="" asp-controller="SchedulerComparison" asp-action="Index">
                    <i class="fas fa-balance-scale me-1"></i><span>Compare</span>
                </a>
                <a class="topnav__link @(controller == "Report" ? "active" : "")"
                   asp-area="" asp-controller="Report" asp-action="Index">
                    <i class="fas fa-chart-bar me-1"></i><span>Reports</span>
                </a>
                <a class="topnav__link @(controller == "Session" ? "active" : "")"
                   asp-area="" asp-controller="Session" asp-action="Index">
                    <i class="fas fa-cogs me-1"></i><span>Sessions</span>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="topnav__link @(isAdminArea ? "active" : "")"
                       asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
                        <i class="fas fa-shield-alt me-1"></i><span>Admin</span>
                    </a>
                }
            }
        </div>

        <div class="topnav__right">
            <button class="btn-ghost btn-sm" id="theme-toggle" title="Toggle Dark Mode">
                <i class="fas fa-moon"></i>
            </button>
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="dropdown">
                    <button class="btn-ghost btn-sm dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-user-circle me-1"></i> @User.Identity?.Name
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text text-muted small">Signed in as @User.Identity?.Name</span></li>
                        <li><span class="dropdown-item-text text-muted small" style="text-transform:uppercase;font-size:10px;letter-spacing:.05em;">@(User.IsInRole("Admin") ? "Admin" : "User")</span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt me-1"></i> Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn-ghost btn-sm" asp-area="Identity" asp-page="/Account/Login">
                    <i class="fas fa-sign-in-alt me-1"></i> Login
                </a>
                <a class="btn-primary btn-sm" asp-area="Identity" asp-page="/Account/Register">
                    <i class="fas fa-user-plus me-1"></i> Register
                </a>
            }
        </div>
    </nav>

    <div class="layout-wrapper">
        <!-- Sidebar -->
        @if (SignInManager.IsSignedIn(User))
        {
            <aside class="sidebar" id="sidebar">
                <nav class="sidebar__nav">
                    @* ── MAIN SECTION ── *@
                    <span class="section-label" style="padding:4px 12px 6px;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);">Main</span>

                    <a class="sidebar__item @(controller == "Dashboard" ? "active" : "")"
                       asp-area="" asp-controller="Dashboard" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        <span>Dashboard</span>
                    </a>
                    <a class="sidebar__item @(controller == "Simulation" ? "active" : "")"
                       asp-area="" asp-controller="Simulation" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                        <span>Simulate</span>
                    </a>
                    <a class="sidebar__item @(controller == "SchedulerComparison" ? "active" : "")"
                       asp-area="" asp-controller="SchedulerComparison" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                        <span>Compare</span>
                    </a>
                    <a class="sidebar__item @(controller == "Process" ? "active" : "")"
                       asp-area="" asp-controller="Process" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        <span>Processes</span>
                    </a>
                    <a class="sidebar__item @(controller == "Session" ? "active" : "")"
                       asp-area="" asp-controller="Session" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                        <span>Sessions</span>
                    </a>
                    <a class="sidebar__item @(controller == "Report" ? "active" : "")"
                       asp-area="" asp-controller="Report" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        <span>Reports</span>
                    </a>

                    @* ── ADMIN ONLY SECTION ── *@
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="sidebar__divider"></div>
                        <span class="section-label" style="padding:4px 12px 6px;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);">Admin</span>

                        <a class="sidebar__item @(isAdminArea && controller == "AdminDashboard" ? "active" : "")"
                           asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            <span>Dashboard</span>
                        </a>
                        <a class="sidebar__item @(isAdminArea && controller == "UserManagement" ? "active" : "")"
                           asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>Users</span>
                        </a>
                        <a class="sidebar__item @(isAdminArea && controller == "ProcessManagement" ? "active" : "")"
                           asp-area="Admin" asp-controller="ProcessManagement" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            <span>Processes</span>
                        </a>
                        <a class="sidebar__item @(isAdminArea && controller == "SessionManagement" ? "active" : "")"
                           asp-area="Admin" asp-controller="SessionManagement" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
                            <span>Sessions</span>
                        </a>
                        <a class="sidebar__item @(isAdminArea && controller == "ActivityLogs" ? "active" : "")"
                           asp-area="Admin" asp-controller="ActivityLogs" asp-action="Index">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span>Activity Logs</span>
                        </a>
                    }
                </nav>

                @* ── BOTTOM: USER INFO + LOGOUT ── *@
                <div class="sidebar__collapse-btn" style="margin-top:auto;border-top:1px solid var(--border-subtle);padding:12px;display:flex;align-items:center;gap:8px;">
                    <div style="flex:1;display:flex;align-items:center;gap:8px;min-width:0;">
                        <div style="width:28px;height:28px;border-radius:50%;background:var(--accent-primary-dim);color:var(--accent-primary);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div style="display:flex;flex-direction:column;min-width:0;">
                            <span style="font-size:12px;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@User.Identity?.Name</span>
                            <span style="font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em;">@(User.IsInRole("Admin") ? "Admin" : "User")</span>
                        </div>
                    </div>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="margin:0;">
                        <button type="submit" class="btn-ghost btn-icon btn-sm" title="Sign out" style="border:none;color:var(--text-muted);padding:4px;">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </form>
                </div>
            </aside>
        }

        <!-- Main Content -->
        <main class="main-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Warning"]
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/edfrr-theme.js" asp-append-version="true"></script>
    <script src="~/js/edfrr-charts.js" asp-append-version="true"></script>
    <script src="~/js/edfrr-ui.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>