@model ERDRR.Models.ViewModels.SessionListViewModel
@{
    ViewData["Title"] = "Scheduling Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-cogs me-2"></i>Scheduling Sessions</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i>New Session
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-8">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search sessions..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i>Search
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model.Sessions.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Algorithm</th>
                            <th>Time Quantum</th>
                            <th>Processes</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model.Sessions)
                        {
                            <tr>
                                <td>
                                    <strong>@session.Name</strong>
                                    @if (!string.IsNullOrEmpty(session.Description))
                                    {
                                        <br /><small class="text-muted">@session.Description</small>
                                    }
                                </td>
                                <td><span class="badge bg-info">@session.AlgorithmType</span></td>
                                <td>@session.TimeQuantum</td>
                                <td><span class="badge bg-secondary">@session.ProcessCount processes</span></td>
                                <td>
                                    @if (session.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Created</span>
                                    }
                                </td>
                                <td>@session.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Process" asp-action="Index" asp-route-sessionId="@session.Id"
                                           class="btn btn-outline-primary" title="Processes">
                                            <i class="fas fa-list"></i>
                                        </a>
                                        <a asp-controller="Simulation" asp-action="Index" asp-route-sessionId="@session.Id"
                                           class="btn btn-outline-success" title="Simulate">
                                            <i class="fas fa-play"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@session.Id"
                                           class="btn btn-outline-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@session.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"
                                                    onclick="return confirm('Are you sure?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">No sessions found.</p>
                <a asp-action="Create" class="btn btn-primary">Create First Session</a>
            </div>
        }
    </div>
</div>
