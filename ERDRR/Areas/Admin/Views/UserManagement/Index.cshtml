@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-users-cog me-2"></i>User Management</h2>
        <small class="text-muted" id="showingInfo"></small>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportExcel", new { searchTerm = "", roleFilter = "", statusFilter = "" })"
           class="btn btn-outline-success btn-sm" id="btnExportExcel"><i class="fas fa-file-excel me-1"></i>Export Excel</a>
        <a href="@Url.Action("ExportPdf", new { searchTerm = "", roleFilter = "", statusFilter = "" })"
           class="btn btn-outline-danger btn-sm" id="btnExportPdf"><i class="fas fa-file-pdf me-1"></i>Export PDF</a>
    </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Search</label>
                <input type="text" class="form-control" placeholder="Username, email, name..." id="searchInput" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Role</label>
                <select class="form-select" id="roleFilter">
                    <option value="">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="User">User</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Status</label>
                <select class="form-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Locked">Locked</option>
                </select>
            </div>
            <div class="col-md-5 d-flex align-items-end gap-2">
                <button type="button" class="btn btn-primary" id="btnSearch"><i class="fas fa-search me-1"></i>Search</button>
                <button type="button" class="btn btn-outline-secondary" id="btnReset"><i class="fas fa-redo me-1"></i>Reset</button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Actions -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body d-flex gap-2 align-items-center">
        <span class="fw-bold"><span id="selectedCount">0</span> selected</span>
        <button type="button" class="btn btn-outline-warning btn-sm" id="btnBulkLock" disabled>
            <i class="fas fa-lock me-1"></i>Lock
        </button>
        <button type="button" class="btn btn-outline-success btn-sm" id="btnBulkUnlock" disabled>
            <i class="fas fa-unlock me-1"></i>Unlock
        </button>
        <button type="button" class="btn btn-outline-danger btn-sm" id="btnBulkDelete" disabled>
            <i class="fas fa-trash me-1"></i>Delete
        </button>
    </div>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="usersTable" class="table table-hover align-middle mb-0" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th width="30">#</th>
                        <th width="40"><input type="checkbox" id="selectAll" class="form-check-input" /></th>
                        <th data-sort="userName">Username</th>
                        <th data-sort="email">Email</th>
                        <th>Role</th>
                        <th data-sort="createdAt">Created</th>
                        <th>Status</th>
                        <th width="220">Actions</th>
                    </tr>
                </thead>
                <tbody id="usersBody"></tbody>
            </table>
        </div>
        <!-- Loading Spinner -->
        <div id="loadingSpinner" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Loading users...</p>
        </div>
        <!-- Empty State -->
        <div id="emptyState" class="text-center py-5 d-none">
            <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
            <p class="text-muted mb-0">No users found matching your criteria.</p>
            <button type="button" class="btn btn-link" id="btnClearFilters">Clear Filters</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var table = null;
    var selectedIds = new Set();
    var baseUrl = '@Url.Action("Index")' + '/';

    function getAjaxUrl() {
        return '@Url.Action("GetUsers")';
    }

    function initTable() {
        table = $('#usersTable').DataTable({
            processing: true,
            serverSide: true,
            ajax: {
                url: getAjaxUrl(),
                type: 'GET',
                data: function (d) {
                    d.search = $('#searchInput').val();
                    d.roleFilter = $('#roleFilter').val();
                    d.statusFilter = $('#statusFilter').val();
                    d.sortColumn = getSortColumn(d);
                    d.sortDirection = getSortDirection(d);
                },
                beforeSend: function () {
                    $('#loadingSpinner').removeClass('d-none');
                    $('#usersTable').css('opacity', '0.5');
                },
                complete: function () {
                    $('#loadingSpinner').addClass('d-none');
                    $('#usersTable').css('opacity', '1');
                    updateShowingInfo();
                    updateExportLinks();
                },
            },
            columns: [
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    width: '30px',
                    render: function (data, type, row, meta) {
                        return '<span class="text-muted">' + (meta.row + 1) + '</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    width: '40px',
                    render: function (data, type, row, meta) {
                        return '<input type="checkbox" class="form-check-input user-checkbox" value="' + row.userId + '" />';
                    }
                },
                {
                    data: 'userName',
                    render: function (data, type, row) {
                        var initials = (row.firstName || '').charAt(0) + (row.lastName || '').charAt(0);
                        return '<div class="d-flex align-center">' +
                            '<div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width:35px;height:35px;font-size:14px;">' + initials + '</div>' +
                            '<div><a href="' + baseUrl + 'Details/' + row.userId + '" class="fw-bold text-decoration-none">' + escapeHtml(data) + '</a>' +
                            '<br /><small class="text-muted">' + escapeHtml(row.firstName) + ' ' + escapeHtml(row.lastName) + '</small></div></div>';
                    }
                },
                { data: 'email', render: function (data) { return escapeHtml(data || ''); } },
                {
                    data: 'roles',
                    orderable: false,
                    render: function (data) {
                        if (!data) return '';
                        return data.split(',').map(function (role) {
                            role = role.trim();
                            var cls = role === 'Admin' ? 'bg-danger' : 'bg-primary';
                            return '<span class="badge ' + cls + ' me-1">' + escapeHtml(role) + '</span>';
                        }).join('');
                    }
                },
                {
                    data: 'createdAt',
                    render: function (data) {
                        if (!data) return '';
                        var d = new Date(data);
                        return d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
                    }
                },
                {
                    data: 'status',
                    orderable: false,
                    render: function (data) {
                        if (data === 'Active') return '<span class="badge bg-success">Active</span>';
                        if (data === 'Locked') return '<span class="badge bg-warning text-dark">Locked</span>';
                        return '<span class="badge bg-secondary">' + escapeHtml(data) + '</span>';
                    }
                },
                {
                    data: null,
                    orderable: false,
                    searchable: false,
                    width: '220px',
                    render: function (data, type, row) {
                        var lockBtn = row.status === 'Locked'
                            ? '<button type="button" class="btn btn-outline-success btn-sm btn-user-unlock" data-id="' + row.userId + '" title="Unlock"><i class="fas fa-unlock"></i></button>'
                            : '<button type="button" class="btn btn-outline-warning btn-sm btn-user-lock" data-id="' + row.userId + '" title="Lock"><i class="fas fa-lock"></i></button>';
                        return '<div class="btn-group btn-group-sm">' +
                            '<a href="' + baseUrl + 'Details/' + row.userId + '" class="btn btn-outline-info" title="Details"><i class="fas fa-eye"></i></a>' +
                            '<a href="' + baseUrl + 'Edit/' + row.userId + '" class="btn btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>' +
                            lockBtn +
                            '<button type="button" class="btn btn-outline-danger btn-sm btn-user-delete" data-id="' + row.userId + '" title="Delete"><i class="fas fa-trash"></i></button>' +
                            '</div>';
                    }
                }
            ],
            order: [[2, 'desc']],
            pageLength: 10,
            lengthChange: false,
            language: {
                emptyTable: '<div class="text-center py-4"><i class="fas fa-users-slash fa-2x text-muted mb-2"></i><p class="text-muted mb-0">No users found.</p></div>',
                zeroRecords: '<div class="text-center py-4"><i class="fas fa-search fa-2x text-muted mb-2"></i><p class="text-muted mb-0">No matching users found.</p></div>',
                processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>'
            },
            drawCallback: function () {
                syncCheckboxes();
            }
        });

        // Prevent full page reload on column sort — let DataTables handle it
        $('#usersTable thead th[data-sort]').css('cursor', 'pointer');
    }

    function getSortColumn(d) {
        if (!d.order || !d.order.length) return 'createdAt';
        var colIdx = d.order[0].column;
        var map = { 2: 'userName', 3: 'email', 5: 'createdAt' };
        return map[colIdx] || 'createdAt';
    }

    function getSortDirection(d) {
        if (!d.order || !d.order.length) return 'desc';
        return d.order[0].dir === 'asc' ? 'ASC' : 'DESC';
    }

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    function updateShowingInfo() {
        var info = table.page.info();
        if (info) {
            $('#showingInfo').text('Showing ' + (info.start + 1) + '-' + info.end + ' of ' + info.recordsTotal + ' users');
        }
    }

    function updateExportLinks() {
        var search = encodeURIComponent($('#searchInput').val() || '');
        var role = encodeURIComponent($('#roleFilter').val() || '');
        var status = encodeURIComponent($('#statusFilter').val() || '');
        var base = '@Url.Action("ExportExcel")' + '?searchTerm=' + search + '&roleFilter=' + role + '&statusFilter=' + status;
        var basePdf = '@Url.Action("ExportPdf")' + '?searchTerm=' + search + '&roleFilter=' + role + '&statusFilter=' + status;
        $('#btnExportExcel').attr('href', base);
        $('#btnExportPdf').attr('href', basePdf);
    }

    function syncCheckboxes() {
        var allChecked = true;
        var anyChecked = false;
        $('#usersBody .user-checkbox').each(function () {
            if (selectedIds.has(this.value)) {
                this.checked = true;
                anyChecked = true;
            } else {
                this.checked = false;
                allChecked = false;
            }
        });
        $('#selectAll').prop('checked', allChecked && anyChecked);
        updateSelectedCount();
    }

    function updateSelectedCount() {
        var count = selectedIds.size;
        $('#selectedCount').textContent = count;
        $('#selectedCount').text(count);
        $('#btnBulkLock, #btnBulkUnlock, #btnBulkDelete').prop('disabled', count === 0);
    }

    function postAction(url, ids, token) {
        var data = { selectedIds: ids, __RequestVerificationToken: token };
        return $.ajax({
            url: url,
            type: 'POST',
            data: data,
            traditional: true
        });
    }

    // Search / Reset
    $('#btnSearch').on('click', function () { selectedIds.clear(); table.ajax.reload(null, true); });
    $('#btnReset').on('click', function () {
        $('#searchInput').val('');
        $('#roleFilter').val('');
        $('#statusFilter').val('');
        selectedIds.clear();
        table.ajax.reload(null, true);
    });
    $('#btnClearFilters').on('click', function () {
        $('#searchInput').val('');
        $('#roleFilter').val('');
        $('#statusFilter').val('');
        selectedIds.clear();
        table.ajax.reload(null, true);
    });

    // Debounced search on Enter
    var searchTimer = null;
    $('#searchInput').on('keyup', function (e) {
        if (e.key === 'Enter') {
            selectedIds.clear();
            table.ajax.reload(null, true);
        }
    });

    // Select All
    $('#selectAll').on('change', function () {
        var checked = this.checked;
        $('#usersBody .user-checkbox').each(function () {
            this.checked = checked;
            if (checked) selectedIds.add(this.value); else selectedIds.delete(this.value);
        });
        updateSelectedCount();
    });

    // Individual checkbox
    $('#usersBody').on('change', '.user-checkbox', function () {
        if (this.checked) selectedIds.add(this.value); else selectedIds.delete(this.value);
        var total = $('#usersBody .user-checkbox').length;
        var checked = $('#usersBody .user-checkbox:checked').length;
        $('#selectAll').prop('checked', total > 0 && checked === total);
        updateSelectedCount();
    });

    // Bulk Actions with SweetAlert
    var token = $('input[name="__RequestVerificationToken"]').first().val() || '';
    var bulkUrl = '@Url.Action("BulkAction")';

    $('#btnBulkLock').on('click', function () {
        if (!selectedIds.size) return;
        Swal.fire({
            title: 'Lock ' + selectedIds.size + ' user(s)?',
            text: 'Locked users will be unable to log in.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ffc107',
            confirmButtonText: 'Yes, lock them!'
        }).then(function (result) {
            if (result.isConfirmed) {
                Swal.fire({ title: 'Locking...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                postAction(bulkUrl + '?action=lock', Array.from(selectedIds), token)
                    .done(function (res) {
                        selectedIds.clear();
                        table.ajax.reload(null, true);
                        Swal.fire('Locked!', res.message || 'Users locked.', 'success');
                    })
                    .fail(function () { Swal.fire('Error', 'Failed to lock users.', 'error'); });
            }
        });
    });

    $('#btnBulkUnlock').on('click', function () {
        if (!selectedIds.size) return;
        Swal.fire({
            title: 'Unlock ' + selectedIds.size + ' user(s)?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            confirmButtonText: 'Yes, unlock them!'
        }).then(function (result) {
            if (result.isConfirmed) {
                Swal.fire({ title: 'Unlocking...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                postAction(bulkUrl + '?action=unlock', Array.from(selectedIds), token)
                    .done(function (res) {
                        selectedIds.clear();
                        table.ajax.reload(null, true);
                        Swal.fire('Unlocked!', res.message || 'Users unlocked.', 'success');
                    })
                    .fail(function () { Swal.fire('Error', 'Failed to unlock users.', 'error'); });
            }
        });
    });

    $('#btnBulkDelete').on('click', function () {
        if (!selectedIds.size) return;
        Swal.fire({
            title: 'Delete ' + selectedIds.size + ' user(s)?',
            text: 'This action cannot be undone.',
            icon: 'error',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Yes, delete them!'
        }).then(function (result) {
            if (result.isConfirmed) {
                Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                postAction(bulkUrl + '?action=delete', Array.from(selectedIds), token)
                    .done(function (res) {
                        selectedIds.clear();
                        table.ajax.reload(null, true);
                        Swal.fire('Deleted!', res.message || 'Users deleted.', 'success');
                    })
                    .fail(function () { Swal.fire('Error', 'Failed to delete users.', 'error'); });
            }
        });
    });

    // Individual user actions
    $('#usersTable').on('click', '.btn-user-lock', function () {
        var id = $(this).data('id');
        Swal.fire({
            title: 'Lock this user?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ffc107',
            confirmButtonText: 'Lock'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Lock")/' + id,
                    type: 'POST',
                    data: { __RequestVerificationToken: token }
                }).done(function () {
                    table.ajax.reload(null, true);
                    Swal.fire('Locked!', 'User locked.', 'success');
                }).fail(function () { Swal.fire('Error', 'Failed to lock user.', 'error'); });
            }
        });
    });

    $('#usersTable').on('click', '.btn-user-unlock', function () {
        var id = $(this).data('id');
        Swal.fire({
            title: 'Unlock this user?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#28a745',
            confirmButtonText: 'Unlock'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Unlock")/' + id,
                    type: 'POST',
                    data: { __RequestVerificationToken: token }
                }).done(function () {
                    table.ajax.reload(null, true);
                    Swal.fire('Unlocked!', 'User unlocked.', 'success');
                }).fail(function () { Swal.fire('Error', 'Failed to unlock user.', 'error'); });
            }
        });
    });

    $('#usersTable').on('click', '.btn-user-delete', function () {
        var id = $(this).data('id');
        Swal.fire({
            title: 'Delete this user?',
            text: 'This action cannot be undone.',
            icon: 'error',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Delete'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Delete")/' + id,
                    type: 'POST',
                    data: { __RequestVerificationToken: token }
                }).done(function () {
                    table.ajax.reload(null, true);
                    Swal.fire('Deleted!', 'User deleted.', 'success');
                }).fail(function () { Swal.fire('Error', 'Failed to delete user.', 'error'); });
            }
        });
    });

    initTable();
})();
</script>
}
