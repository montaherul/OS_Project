@model ERDRR.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var stats = Model.Statistics;
    var hasSession = stats.SessionId > 0;
    var jsonSerializerOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tachometer-alt me-2"></i>Dashboard</h2>
    <div class="d-flex gap-2">
        <a asp-controller="Session" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>New Session
        </a>
    </div>
</div>

<!-- Session Selector -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="form-label fw-bold">Select Session to Analyze</label>
                <select name="sessionId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Select a Session --</option>
                    @if (stats.AllSessions != null)
                    {
                        @foreach (var session in stats.AllSessions)
                        {
                            <option value="@session.Id" selected="@(Model.SelectedSessionId == session.Id)">
                                @session.Name (@session.AlgorithmType) - @session.CreatedAt.ToString("MMM dd, yyyy")
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                @if (hasSession)
                {
                    <div class="d-flex gap-2">
                        <a asp-controller="Simulation" asp-action="Index" asp-route-sessionId="@stats.SessionId" class="btn btn-success">
                            <i class="fas fa-play me-1"></i>Run Simulation
                        </a>
                        <a asp-controller="Report" asp-action="Index" asp-route-sessionId="@stats.SessionId" class="btn btn-info">
                            <i class="fas fa-file-alt me-1"></i>View Report
                        </a>
                    </div>
                }
            </div>
        </form>
    </div>
</div>

@if (hasSession)
{
    <!-- Session Info Banner -->
    <div class="card border-0 shadow-sm mb-4 bg-info text-white">
        <div class="card-body">
            <div class="row">
                <div class="col-md-2">
                    <small class="text-white-50">Session</small>
                    <h5 class="mb-0">@stats.SessionName</h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Session ID</small>
                    <h5 class="mb-0">#@stats.SessionId</h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Algorithm</small>
                    <h5 class="mb-0"><span class="badge bg-white text-info">@stats.AlgorithmType</span></h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Created</small>
                    <h5 class="mb-0">@stats.SessionCreatedDate.ToString("MMM dd, yyyy")</h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Processes</small>
                    <h5 class="mb-0">@stats.SessionProcessCount</h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Execution Time</small>
                    <h5 class="mb-0">@stats.TotalExecutionTime</h5>
                </div>
            </div>
        </div>
    </div>
}

<!-- Metric Cards Row 1 -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-white-50">@(hasSession ? "Session Processes" : "Total Processes")</h6>
                        <h2>@(hasSession ? stats.SessionProcessCount : stats.TotalProcesses)</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-list fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-white-50">Completed</h6>
                        <h2>@stats.CompletedProcesses</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-white-50">Missed Deadlines</h6>
                        <h2>@stats.MissedDeadlines</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-exclamation-triangle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-white-50">Total Sessions</h6>
                        <h2>@stats.TotalSessions</h2>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-layer-group fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Metric Cards Row 2 -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-primary">@stats.CpuUtilization.ToString("F1")%</h3>
                <p class="text-muted mb-0">CPU Utilization</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-success">@stats.Throughput.ToString("F4")</h3>
                <p class="text-muted mb-0">Throughput</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-warning">@stats.AverageWaitingTime.ToString("F2")</h3>
                <p class="text-muted mb-0">Avg Waiting Time</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-info">@stats.AverageTurnaroundTime.ToString("F2")</h3>
                <p class="text-muted mb-0">Avg Turnaround Time</p>
            </div>
        </div>
    </div>
</div>

<!-- Metric Cards Row 3 -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-secondary">@stats.AverageResponseTime.ToString("F2")</h3>
                <p class="text-muted mb-0">Avg Response Time</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-danger">@stats.ContextSwitchCount</h3>
                <p class="text-muted mb-0">Context Switches</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-success">@stats.DeadlineSuccessRate.ToString("F1")%</h3>
                <p class="text-muted mb-0">Deadline Success Rate</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <h3 class="text-primary">@stats.TotalExecutionTime</h3>
                <p class="text-muted mb-0">Total Execution Time</p>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 1: Process Stats + Deadline Success -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Process Statistics</h5>
            </div>
            <div class="card-body">
                <canvas id="processChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Deadline Success Rate</h5>
            </div>
            <div class="card-body">
                <canvas id="deadlineChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 2: Waiting + Turnaround Time Analysis -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Waiting Time Analysis (per Process)</h5>
            </div>
            <div class="card-body">
                <canvas id="waitingTimeChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-hourglass-half me-2"></i>Turnaround Time Analysis (per Process)</h5>
            </div>
            <div class="card-body">
                <canvas id="turnaroundTimeChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 3: Response Time + Context Switch -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Response Time Analysis (per Process)</h5>
            </div>
            <div class="card-body">
                <canvas id="responseTimeChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-exchange-alt me-2"></i>Session Comparison</h5>
            </div>
            <div class="card-body">
                <canvas id="sessionComparisonChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 4: Throughput -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-tachometer-alt me-2"></i>Throughput Analysis (per Session)</h5>
            </div>
            <div class="card-body">
                <canvas id="throughputChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Process Results Table -->
@if (hasSession && stats.ProcessResults.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-table me-2"></i>Process Simulation Results</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Process</th>
                            <th>Arrival</th>
                            <th>Burst</th>
                            <th>Deadline</th>
                            <th>Completion</th>
                            <th>Waiting</th>
                            <th>Turnaround</th>
                            <th>Response</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in stats.ProcessResults)
                        {
                            <tr>
                                <td><strong>@p.ProcessName</strong><br /><small class="text-muted">@p.ProcessId</small></td>
                                <td>@p.ArrivalTime</td>
                                <td>@p.BurstTime</td>
                                <td>@p.Deadline</td>
                                <td>@p.CompletionTime</td>
                                <td>@p.WaitingTime</td>
                                <td>@p.TurnaroundTime</td>
                                <td>@p.ResponseTime</td>
                                <td>
                                    @if (p.MissedDeadline)
                                    {
                                        <span class="badge bg-danger">Missed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Recent Sessions Table -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-history me-2"></i>All Sessions</h5>
        <a asp-controller="Session" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body">
        @if (stats.AllSessions != null && stats.AllSessions.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Algorithm</th>
                            <th>Time Quantum</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in stats.AllSessions)
                        {
                            <tr class="@(Model.SelectedSessionId == session.Id ? "table-active" : "")">
                                <td>@session.Name</td>
                                <td><span class="badge bg-info">@session.AlgorithmType</span></td>
                                <td>@session.TimeQuantum</td>
                                <td>
                                    @if (session.Status == "Completed")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Created</span>
                                    }
                                </td>
                                <td>@session.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a asp-controller="Process" asp-action="Index" asp-route-sessionId="@session.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-list"></i>
                                    </a>
                                    <a asp-controller="Simulation" asp-action="Index" asp-route-sessionId="@session.Id" class="btn btn-sm btn-outline-success">
                                        <i class="fas fa-play"></i>
                                    </a>
                                    <a asp-action="Index" asp-route-sessionId="@session.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-chart-bar"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">No sessions yet. Create your first scheduling session!</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        var processResults = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.ProcessResults, jsonSerializerOptions));
        var processStats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.ProcessStatistics, jsonSerializerOptions));
        var sessionPerformances = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.SessionPerformances, jsonSerializerOptions));

        // 1. Process Statistics (Doughnut)
        if (document.getElementById('processChart')) {
            new Chart(document.getElementById('processChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: processStats.map(p => p.status),
                    datasets: [{
                        data: processStats.map(p => p.count),
                        backgroundColor: ['#28a745', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        // 2. Deadline Success Rate (Doughnut)
        if (document.getElementById('deadlineChart')) {
            var completed = processResults.filter(p => !p.missedDeadline).length;
            var missed = processResults.filter(p => p.missedDeadline).length;
            new Chart(document.getElementById('deadlineChart').getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: ['On Time', 'Missed Deadline'],
                    datasets: [{
                        data: [completed, missed],
                        backgroundColor: ['#28a745', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        // 3. Waiting Time Analysis (Bar)
        if (document.getElementById('waitingTimeChart')) {
            new Chart(document.getElementById('waitingTimeChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: processResults.map(p => p.processName),
                    datasets: [{
                        label: 'Waiting Time',
                        data: processResults.map(p => p.waitingTime),
                        backgroundColor: processResults.map(p => p.missedDeadline ? 'rgba(220, 53, 69, 0.7)' : 'rgba(255, 193, 7, 0.7)')
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // 4. Turnaround Time Analysis (Bar)
        if (document.getElementById('turnaroundTimeChart')) {
            new Chart(document.getElementById('turnaroundTimeChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: processResults.map(p => p.processName),
                    datasets: [{
                        label: 'Turnaround Time',
                        data: processResults.map(p => p.turnaroundTime),
                        backgroundColor: processResults.map(p => p.missedDeadline ? 'rgba(220, 53, 69, 0.7)' : 'rgba(13, 110, 253, 0.7)')
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // 5. Response Time Analysis (Bar)
        if (document.getElementById('responseTimeChart')) {
            new Chart(document.getElementById('responseTimeChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: processResults.map(p => p.processName),
                    datasets: [{
                        label: 'Response Time',
                        data: processResults.map(p => p.responseTime),
                        backgroundColor: processResults.map(p => p.missedDeadline ? 'rgba(220, 53, 69, 0.7)' : 'rgba(23, 162, 184, 0.7)')
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // 6. Session Comparison (Grouped Bar)
        if (document.getElementById('sessionComparisonChart')) {
            new Chart(document.getElementById('sessionComparisonChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: sessionPerformances.map(s => s.sessionName),
                    datasets: [
                        {
                            label: 'CPU Utilization %',
                            data: sessionPerformances.map(s => s.cpuUtilization),
                            backgroundColor: 'rgba(13, 110, 253, 0.7)'
                        },
                        {
                            label: 'Missed Deadlines',
                            data: sessionPerformances.map(s => s.missedDeadlines),
                            backgroundColor: 'rgba(220, 53, 69, 0.7)'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        // 7. Throughput Analysis (Bar)
        if (document.getElementById('throughputChart')) {
            new Chart(document.getElementById('throughputChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: sessionPerformances.map(s => s.sessionName),
                    datasets: [{
                        label: 'Throughput',
                        data: sessionPerformances.map(s => s.throughput),
                        backgroundColor: 'rgba(40, 167, 69, 0.7)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        }
    </script>
}
