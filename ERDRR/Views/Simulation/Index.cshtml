@model ERDRR.Models.ViewModels.SimulationViewModel
@{
    ViewData["Title"] = $"Simulation - {Model.SessionName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-play-circle me-2"></i>Simulation</h2>
        <small class="text-muted">@Model.SessionName | Algorithm: @Model.AlgorithmType | Quantum: @Model.TimeQuantum | Preemptive: @(Model.IsPreemptive ? "Yes" : "No")</small>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="RunFull" asp-route-sessionId="@Model.SessionId" method="post">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-forward me-1"></i>Run Full Simulation
            </button>
        </form>
        <a asp-controller="Process" asp-action="Index" asp-route-sessionId="@Model.SessionId" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Processes
        </a>
    </div>
</div>

@if (Model.Processes.Any())
{
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-gantt me-2"></i>Gantt Chart</h5>
                </div>
                <div class="card-body">
                    <div id="ganttContainer" style="overflow-x:auto; min-height:100px;">
                        @if (Model.GanttChart.Any())
                        {
                            <canvas id="ganttChart" height="150"></canvas>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fas fa-chart-bar fa-2x mb-2"></i>
                                <p>Run the simulation to see the Gantt chart</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Metrics</h5>
                </div>
                <div class="card-body">
                    @if (Model.FinalMetrics != null)
                    {
                        <table class="table table-sm">
                            <tr><td>Avg Waiting Time</td><td class="text-end fw-bold">@Model.FinalMetrics.AverageWaitingTime</td></tr>
                            <tr><td>Avg Turnaround Time</td><td class="text-end fw-bold">@Model.FinalMetrics.AverageTurnaroundTime</td></tr>
                            <tr><td>Avg Response Time</td><td class="text-end fw-bold">@Model.FinalMetrics.AverageResponseTime</td></tr>
                            <tr><td>CPU Utilization</td><td class="text-end fw-bold">@Model.FinalMetrics.CpuUtilization%</td></tr>
                            <tr><td>Throughput</td><td class="text-end fw-bold">@Model.FinalMetrics.Throughput</td></tr>
                            <tr><td>Context Switches</td><td class="text-end fw-bold">@Model.FinalMetrics.ContextSwitchCount</td></tr>
                            <tr><td>Missed Deadlines</td><td class="text-end fw-bold text-danger">@Model.FinalMetrics.MissedDeadlines</td></tr>
                            <tr><td>Deadline Success</td><td class="text-end fw-bold text-success">@(100 - Model.FinalMetrics.DeadlineMissRatio)%</td></tr>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center">Run simulation to see metrics</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-list-alt me-2"></i>Process Details</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>PID</th>
                            <th>Name</th>
                            <th>Arrival</th>
                            <th>Burst</th>
                            <th>Deadline</th>
                            <th>Remaining</th>
                            <th>Completion</th>
                            <th>Waiting</th>
                            <th>Turnaround</th>
                            <th>Response</th>
                            <th>State</th>
                            <th>Missed</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CurrentStep?.ProcessStates != null)
                        {
                            @foreach (var ps in Model.CurrentStep.ProcessStates)
                            {
                                var proc = Model.Processes.FirstOrDefault(p => p.ProcessId == ps.ProcessId);
                                var result = Model.GanttChart.Where(g => g.ProcessId == ps.ProcessId).ToList();
                                <tr class="@(ps.MissedDeadline ? "table-danger" : "")">
                                    <td><code>@ps.ProcessId</code></td>
                                    <td>@ps.ProcessName</td>
                                    <td>@(proc?.ArrivalTime)</td>
                                    <td>@(proc?.BurstTime)</td>
                                    <td>@ps.Deadline</td>
                                    <td>@ps.RemainingTime</td>
                                    <td>
                                        @if (ps.State == "Completed" && result.Any())
                                        {
                                            @result.Max(g => g.EndTime)
                                        }
                                    </td>
                                    <td>
                                        @if (ps.State == "Completed" && result.Any())
                                        {
                                            @(result.Max(g => g.EndTime) - (proc?.ArrivalTime ?? 0) - (proc?.BurstTime ?? 0))
                                        }
                                    </td>
                                    <td>
                                        @if (ps.State == "Completed" && result.Any())
                                        {
                                            @(result.Max(g => g.EndTime) - (proc?.ArrivalTime ?? 0))
                                        }
                                    </td>
                                    <td>
                                        @if (result.Any())
                                        {
                                            @(result.Min(g => g.StartTime) - (proc?.ArrivalTime ?? 0))
                                        }
                                    </td>
                                    <td>
                                        @switch (ps.State)
                                        {
                                            case "Completed":
                                                <span class="badge bg-success">Completed</span>
                                                break;
                                            case "Running":
                                                <span class="badge bg-primary">Running</span>
                                                break;
                                            case "Ready":
                                                <span class="badge bg-warning">Ready</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@ps.State</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (ps.MissedDeadline)
                                        {
                                            <i class="fas fa-exclamation-triangle text-danger" title="Missed Deadline"></i>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            @foreach (var p in Model.Processes)
                            {
                                <tr>
                                    <td><code>@p.ProcessId</code></td>
                                    <td>@p.Name</td>
                                    <td>@p.ArrivalTime</td>
                                    <td>@p.BurstTime</td>
                                    <td>@p.Deadline</td>
                                    <td>@p.BurstTime</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td>-</td>
                                    <td><span class="badge bg-secondary">Pending</span></td>
                                    <td></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.ExecutionLogs.Any())
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-scroll me-2"></i>Execution Log</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
                    <table class="table table-sm table-hover">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Time</th>
                                <th>Action</th>
                                <th>Process</th>
                                <th>Details</th>
                                <th>Ready Queue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.ExecutionLogs.OrderBy(l => l.TimeStep))
                            {
                                <tr class="@(
                                    log.Action == "Complete" ? "table-success" :
                                    log.Action == "Preempt" ? "table-warning" :
                                    log.Action == "Idle" ? "table-secondary" : ""
                                )">
                                    <td>@log.TimeStep</td>
                                    <td>
                                        @switch (log.Action)
                                        {
                                            case "Execute":
                                                <span class="badge bg-primary">Execute</span>
                                                break;
                                            case "Preempt":
                                                <span class="badge bg-warning text-dark">Preempt</span>
                                                break;
                                            case "Complete":
                                                <span class="badge bg-success">Complete</span>
                                                break;
                                            case "Idle":
                                                <span class="badge bg-secondary">Idle</span>
                                                break;
                                            default:
                                                <span class="badge bg-info">@log.Action</span>
                                                break;
                                        }
                                    </td>
                                    <td><code>@log.ProcessId</code></td>
                                    <td><small>@log.Details</small></td>
                                    <td><small class="text-muted">[@log.ReadyQueue]</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.FinalMetrics != null)
    {
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <canvas id="metricsChart" height="200"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <canvas id="deadlineChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
            <h4>No Processes Found</h4>
            <p class="text-muted">Add processes to this session before running the simulation.</p>
            <a asp-controller="Process" asp-action="Create" asp-route-sessionId="@Model.SessionId" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Add Process
            </a>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/gantt-chart.js"></script>
    @if (Model.GanttChart.Any())
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var ganttData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GanttChart));
                renderGanttChart('ganttChart', ganttData);
            });
        </script>
    }
    @if (Model.FinalMetrics != null)
    {
        <script>
            var metricsCtx = document.getElementById('metricsChart').getContext('2d');
            new Chart(metricsCtx, {
                type: 'bar',
                data: {
                    labels: ['Waiting', 'Turnaround', 'Response'],
                    datasets: [{
                        label: 'Average Time',
                        data: [@Model.FinalMetrics.AverageWaitingTime, @Model.FinalMetrics.AverageTurnaroundTime, @Model.FinalMetrics.AverageResponseTime],
                        backgroundColor: ['#ffc107', '#17a2b8', '#28a745']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { title: { display: true, text: 'Time Metrics' } } }
            });

            var deadlineCtx = document.getElementById('deadlineChart').getContext('2d');
            new Chart(deadlineCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Completed', 'Missed Deadline'],
                    datasets: [{
                        data: [@Model.FinalMetrics.CompletedProcesses - @Model.FinalMetrics.MissedDeadlines, @Model.FinalMetrics.MissedDeadlines],
                        backgroundColor: ['#28a745', '#dc3545']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { title: { display: true, text: 'Deadline Analysis' } } }
            });
        </script>
    }
}
