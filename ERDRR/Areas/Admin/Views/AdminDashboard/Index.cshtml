@model AdminDashboardDto
@{
    ViewData["Title"] = "Admin Dashboard";
    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="fas fa-shield-alt me-2"></i>Admin Dashboard</h2>
        <small class="text-muted">System-wide overview and analytics</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-users-cog me-1"></i>Manage Users
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats Cards Row 1 -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.TotalUsers</h3>
                    <small>Total Users</small>
                </div>
                <i class="fas fa-users fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-success text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.ActiveUsers</h3>
                    <small>Active Users</small>
                </div>
                <i class="fas fa-user-check fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-info text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.TotalProcesses</h3>
                    <small>Total Processes</small>
                </div>
                <i class="fas fa-list fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-warning text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.TotalSessions</h3>
                    <small>Total Sessions</small>
                </div>
                <i class="fas fa-layer-group fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Stats Cards Row 2 -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-danger text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.TotalSimulations</h3>
                    <small>Total Simulations</small>
                </div>
                <i class="fas fa-play-circle fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-secondary text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.TotalComparisons</h3>
                    <small>Comparisons</small>
                </div>
                <i class="fas fa-balance-scale fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-dark text-white h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.TotalReports</h3>
                    <small>Reports Generated</small>
                </div>
                <i class="fas fa-file-alt fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-0">@Model.AdminCount</h3>
                    <small>Admin Users</small>
                </div>
                <i class="fas fa-user-shield fa-3x opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 1 -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Users Registered Per Month</h5>
            </div>
            <div class="card-body">
                <canvas id="registrationChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Process Creation Trend (Last 30 Days)</h5>
            </div>
            <div class="card-body">
                <canvas id="processTrendChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 2 -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-layer-group me-2"></i>Session Creation Trend</h5>
            </div>
            <div class="card-body">
                <canvas id="sessionTrendChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-play-circle me-2"></i>Simulation Trend</h5>
            </div>
            <div class="card-body">
                <canvas id="simulationTrendChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Algorithm Usage</h5>
            </div>
            <div class="card-body">
                <canvas id="algorithmChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row 3 -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-trophy me-2"></i>Top Users By Process Count</h5>
            </div>
            <div class="card-body">
                <canvas id="topUsersChart" height="250"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Overview</h5>
            </div>
            <div class="card-body">
                <div class="row text-center g-3">
                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <h4 class="text-primary mb-1">@Model.TodayLogins</h4>
                            <small class="text-muted">Today's Logins</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <h4 class="text-success mb-1">@Model.UserCount</h4>
                            <small class="text-muted">Regular Users</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <h4 class="text-info mb-1">@Model.TotalSessions</h4>
                            <small class="text-muted">Total Sessions</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light">
                            <h4 class="text-warning mb-1">@Model.TotalComparisons</h4>
                            <small class="text-muted">Algorithm Comparisons</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Sessions Table -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="fas fa-history me-2"></i>Recent Sessions</h5>
        <a asp-controller="Session" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentSessions.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Session Name</th>
                            <th>Algorithm</th>
                            <th>Process Count</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSessions)
                        {
                            <tr>
                                <td class="fw-semibold">@s.SessionName</td>
                                <td><span class="badge bg-info">@s.AlgorithmType</span></td>
                                <td>@s.ProcessCount</td>
                                <td>
                                    <span>@s.CreatedBy</span>
                                    <br /><small class="text-muted">@s.CreatedByEmail</small>
                                </td>
                                <td><small>@s.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted mb-0">No sessions found.</p>
            </div>
        }
    </div>
</div>

<!-- Latest Users + Recent Activities -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-user-plus me-2"></i>Latest Registered Users</h5>
                <a asp-area="Admin" asp-controller="UserManagement" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentUsers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.RecentUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;font-size:12px;">
                                                    @(u.FirstName.FirstOrDefault())@(u.LastName.FirstOrDefault())
                                                </div>
                                                <div>
                                                    <span class="fw-semibold">@u.UserName</span>
                                                    <br /><small class="text-muted">@u.FirstName @u.LastName</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><small>@u.Email</small></td>
                                        <td>
                                            @if (u.Role.Contains("Admin"))
                                            {
                                                <span class="badge bg-danger">Admin</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">User</span>
                                            }
                                        </td>
                                        <td><small>@u.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                        <p class="text-muted mb-0">No users registered yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-activity me-2"></i>System Activity</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item d-flex align-items-center border-0 px-0">
                        <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3" style="width:36px;height:36px;">
                            <i class="fas fa-user-plus fa-sm"></i>
                        </div>
                        <div>
                            <strong>@Model.TotalUsers Users Created</strong>
                            <br /><small class="text-muted">@Model.RegistrationsPerMonth.Sum(r => r.Count) registered in last 12 months</small>
                        </div>
                    </div>
                    <div class="list-group-item d-flex align-items-center border-0 px-0">
                        <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-3" style="width:36px;height:36px;">
                            <i class="fas fa-user-slash fa-sm"></i>
                        </div>
                        <div>
                            <strong>Users Deactivated</strong>
                            <br /><small class="text-muted">@(Model.TotalUsers - Model.ActiveUsers) inactive or locked accounts</small>
                        </div>
                    </div>
                    <div class="list-group-item d-flex align-items-center border-0 px-0">
                        <div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center me-3" style="width:36px;height:36px;">
                            <i class="fas fa-lock fa-sm"></i>
                        </div>
                        <div>
                            <strong>@Model.TotalSessions Sessions Created</strong>
                            <br /><small class="text-muted">Across all users in the system</small>
                        </div>
                    </div>
                    <div class="list-group-item d-flex align-items-center border-0 px-0">
                        <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center me-3" style="width:36px;height:36px;">
                            <i class="fas fa-play fa-sm"></i>
                        </div>
                        <div>
                            <strong>@Model.TotalSimulations Simulations Run</strong>
                            <br /><small class="text-muted">@Model.SimulationTrends.Sum(t => t.Count) in the last 30 days</small>
                        </div>
                    </div>
                    <div class="list-group-item d-flex align-items-center border-0 px-0">
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-3" style="width:36px;height:36px;">
                            <i class="fas fa-file-alt fa-sm"></i>
                        </div>
                        <div>
                            <strong>@Model.TotalReports Reports Generated</strong>
                            <br /><small class="text-muted">PDF and Excel exports</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var registrationData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegistrationsPerMonth, jsonOptions));
        var processTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProcessTrends, jsonOptions));
        var sessionTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SessionTrends, jsonOptions));
        var simulationTrendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SimulationTrends, jsonOptions));
        var algorithmData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AlgorithmUsage, jsonOptions));
        var topUsersData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopUsersByProcessCount, jsonOptions));

        (function() {
            function destroyChart(id) {
                var existing = Chart.getChart(id);
                if (existing) existing.destroy();
            }

            function generateColor(count) {
                var colors = [];
                var palette = ['#667eea', '#764ba2', '#28a745', '#ffc107', '#dc3545', '#17a2b8', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c'];
                for (var i = 0; i < count; i++) {
                    colors.push(palette[i % palette.length]);
                }
                return colors;
            }

            // 1. Users Registered Per Month (Bar)
            if (registrationData && registrationData.length) {
                var ctx = document.getElementById('registrationChart');
                if (ctx) {
                    destroyChart('registrationChart');
                    new Chart(ctx.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: registrationData.map(function(d) { return d.monthLabel; }),
                            datasets: [{
                                label: 'Registrations',
                                data: registrationData.map(function(d) { return d.count; }),
                                backgroundColor: 'rgba(102, 126, 234, 0.7)',
                                borderColor: 'rgba(102, 126, 234, 1)',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true, title: { display: true, text: 'Users' } },
                                x: { title: { display: true, text: 'Month' } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            }

            // 2. Process Creation Trend (Line)
            if (processTrendData && processTrendData.length) {
                var ctx = document.getElementById('processTrendChart');
                if (ctx) {
                    destroyChart('processTrendChart');
                    new Chart(ctx.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: processTrendData.map(function(d) { return new Date(d.day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }),
                            datasets: [{
                                label: 'Processes Created',
                                data: processTrendData.map(function(d) { return d.count; }),
                                borderColor: '#28a745',
                                backgroundColor: 'rgba(40, 167, 69, 0.1)',
                                fill: true,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true, title: { display: true, text: 'Count' } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            }

            // 3. Session Creation Trend (Line)
            if (sessionTrendData && sessionTrendData.length) {
                var ctx = document.getElementById('sessionTrendChart');
                if (ctx) {
                    destroyChart('sessionTrendChart');
                    new Chart(ctx.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: sessionTrendData.map(function(d) { return new Date(d.day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }),
                            datasets: [{
                                label: 'Sessions',
                                data: sessionTrendData.map(function(d) { return d.count; }),
                                borderColor: '#17a2b8',
                                backgroundColor: 'rgba(23, 162, 184, 0.1)',
                                fill: true,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true, title: { display: true, text: 'Count' } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            }

            // 4. Simulation Trend (Line)
            if (simulationTrendData && simulationTrendData.length) {
                var ctx = document.getElementById('simulationTrendChart');
                if (ctx) {
                    destroyChart('simulationTrendChart');
                    new Chart(ctx.getContext('2d'), {
                        type: 'line',
                        data: {
                            labels: simulationTrendData.map(function(d) { return new Date(d.day).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); }),
                            datasets: [{
                                label: 'Simulations',
                                data: simulationTrendData.map(function(d) { return d.count; }),
                                borderColor: '#dc3545',
                                backgroundColor: 'rgba(220, 53, 69, 0.1)',
                                fill: true,
                                tension: 0.3
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                y: { beginAtZero: true, title: { display: true, text: 'Count' } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            }

            // 5. Algorithm Usage (Doughnut)
            if (algorithmData && algorithmData.length) {
                var ctx = document.getElementById('algorithmChart');
                if (ctx) {
                    destroyChart('algorithmChart');
                    new Chart(ctx.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: algorithmData.map(function(d) { return d.algorithmType; }),
                            datasets: [{
                                data: algorithmData.map(function(d) { return d.count; }),
                                backgroundColor: generateColor(algorithmData.length)
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' }
                            }
                        }
                    });
                }
            }

            // 6. Top Users By Process Count (Horizontal Bar)
            if (topUsersData && topUsersData.length) {
                var ctx = document.getElementById('topUsersChart');
                if (ctx) {
                    destroyChart('topUsersChart');
                    new Chart(ctx.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: topUsersData.map(function(d) { return d.userName || d.firstName + ' ' + d.lastName; }),
                            datasets: [{
                                label: 'Processes',
                                data: topUsersData.map(function(d) { return d.processCount; }),
                                backgroundColor: 'rgba(118, 75, 162, 0.7)',
                                borderColor: 'rgba(118, 75, 162, 1)',
                                borderWidth: 1
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { beginAtZero: true, title: { display: true, text: 'Process Count' } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
            }
        })();
    </script>
}
