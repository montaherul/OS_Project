@model EDFRR.Models.ViewModels.SessionListViewModel
@{
    ViewData["Title"] = "Scheduling Sessions";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="fas fa-cogs me-2"></i>Scheduling Sessions</h1>
        <p class="page-header__subtitle">@Model.TotalItems session@(Model.TotalItems != 1 ? "s" : "") found</p>
    </div>
    <div class="page-header__actions">
                <a asp-area="" asp-action="Create" class="btn-primary">
            <i class="fas fa-plus"></i> New Session
        </a>
    </div>
</div>

<div class="card-edfrr mb-4 animate-in">
    <div class="card-edfrr__body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label class="edfrr-label">Search</label>
                <input type="text" name="search" value="@Model.SearchTerm" class="edfrr-input" placeholder="Search sessions by name..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-primary w-100">
                    <i class="fas fa-search"></i> Search
                </button>
            </div>
            <div class="col-md-2">
                <a asp-area="" asp-action="Index" class="btn-ghost w-100">
                    <i class="fas fa-times"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Sessions.Any())
{
    <div class="row g-4">
        @foreach (var session in Model.Sessions)
        {
            <div class="col-12 col-md-6 col-xl-4 animate-in">
                <div class="card-edfrr h-100" style="animation-delay:0.05s;">
                    <div class="card-edfrr__header">
                        <h5 style="font-size:15px;">@session.Name</h5>
                        @if (session.Status == "Completed")
                        {
                            <span class="badge-status badge-status--completed">Completed</span>
                        }
                        else
                        {
                            <span class="badge-status badge-status--waiting">Created</span>
                        }
                    </div>
                    <div class="card-edfrr__body">
                        @if (!string.IsNullOrEmpty(session.Description))
                        {
                            <p style="font-size:13px;color:var(--text-secondary);margin-bottom:12px;">@session.Description</p>
                        }
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge-status badge-status--running">@session.AlgorithmType</span>
                            <span class="pid-tag" style="background:var(--bg-elevated);padding:2px 8px;border-radius:var(--radius-sm);border:1px solid var(--border-subtle);">
                                <i class="fas fa-list me-1" style="color:var(--text-muted);font-size:10px;"></i>@session.ProcessCount processes
                            </span>
                            @if (session.AlgorithmType != "EDF")
                            {
                                <span class="pid-tag" style="background:var(--bg-elevated);padding:2px 8px;border-radius:var(--radius-sm);border:1px solid var(--border-subtle);">
                                    Quantum: @session.TimeQuantum
                                </span>
                            }
                        </div>
                        <div style="font-size:12px;color:var(--text-muted);margin-bottom:16px;">
                            <i class="fas fa-calendar me-1"></i> @session.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            @if (session.IsPreemptive)
                            {
                                <span class="ms-2 badge-status badge-status--pending" style="font-size:9px;">Preemptive</span>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-area="" asp-controller="Process" asp-action="Index" asp-route-sessionId="@session.Id" class="btn-ghost btn-sm flex-fill">
                                <i class="fas fa-list"></i> Processes
                            </a>
                            <a asp-area="" asp-controller="Simulation" asp-action="Index" asp-route-sessionId="@session.Id" class="btn-primary btn-sm flex-fill">
                                <i class="fas fa-play"></i> Simulate
                            </a>
                            <a asp-area="" asp-action="Edit" asp-route-id="@session.Id" class="btn-ghost btn-icon btn-sm" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-area="" asp-action="Delete" asp-route-id="@session.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-danger btn-icon btn-sm" title="Delete"
                                        onclick="return confirm('Delete session &quot;@session.Name&quot;?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    if (Model.TotalPages > 1)
    {
        <nav class="mt-4 d-flex justify-content-center animate-in">
            <ul class="pagination pagination-sm">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-area="" asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="card-edfrr animate-in">
        <div class="card-edfrr__body">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="fas fa-inbox"></i></div>
                <div class="empty-state__title">No Sessions Yet</div>
                <div class="empty-state__desc">Create your first scheduling session to get started.</div>
        <a asp-area="" asp-action="Create" class="btn-primary">
                    <i class="fas fa-plus"></i> Create First Session
                </a>
            </div>
        </div>
    </div>
}
