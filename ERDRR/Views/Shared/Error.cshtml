@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <h1 class="display-4 text-danger"><i class="fas fa-exclamation-triangle"></i></h1>
        <h2 class="text-danger">Error</h2>
        <p class="lead">An error occurred while processing your request.</p>
        @if (Model?.RequestId != null)
        {
            <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
            <i class="fas fa-home me-1"></i>Go Home
        </a>
    </div>
</div>
