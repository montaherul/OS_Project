@model List<ActivityLogDto>
@{
    ViewData["Title"] = "Activity Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-history me-2"></i>Activity Logs</h2>
        <small class="text-muted">Recent system activities</small>
    </div>
    <div>
        <button type="button" class="btn btn-outline-primary" id="btnRefresh">
            <i class="fas fa-sync me-1"></i>Refresh
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="activityLogsTable" class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Description</th>
                        <th>IP Address</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody id="logsBody"></tbody>
            </table>
        </div>
        <div id="loadingSpinner" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Loading activities...</p>
        </div>
        <div id="emptyState" class="text-center py-5 d-none">
            <i class="fas fa-history fa-3x text-muted mb-3"></i>
            <p class="text-muted mb-0">No activities recorded yet.</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    function loadLogs() {
        $('#loadingSpinner').removeClass('d-none');
        $('#activityLogsTable').css('opacity', '0.5');

        $.get('@Url.Action("GetRecent")?count=100', function (logs) {
            $('#loadingSpinner').addClass('d-none');
            $('#activityLogsTable').css('opacity', '1');

            var tbody = $('#logsBody');
            tbody.empty();

            if (!logs || !logs.length) {
                $('#emptyState').removeClass('d-none');
                return;
            }
            $('#emptyState').addClass('d-none');

            logs.forEach(function (log) {
                var d = new Date(log.createdAt);
                var timeStr = d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' });
                var icon = getActionIcon(log.action);

                var row = '<tr>' +
                    '<td>' + log.id + '</td>' +
                    '<td>' + escapeHtml(log.userName || 'System') + '</td>' +
                    '<td><span class="badge ' + icon.cls + '">' + icon.icon + ' ' + escapeHtml(log.action) + '</span></td>' +
                    '<td>' + escapeHtml(log.description) + '</td>' +
                    '<td>' + escapeHtml(log.ipAddress || '-') + '</td>' +
                    '<td><small>' + timeStr + '</small></td>' +
                    '</tr>';
                tbody.append(row);
            });
        }).fail(function () {
            $('#loadingSpinner').addClass('d-none');
            $('#activityLogsTable').css('opacity', '1');
            $('#logsBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Failed to load activity logs.</td></tr>');
        });
    }

    function getActionIcon(action) {
        action = (action || '').toLowerCase();
        if (action.indexOf('login') >= 0) return { icon: '<i class="fas fa-sign-in-alt"></i>', cls: 'bg-success' };
        if (action.indexOf('logout') >= 0) return { icon: '<i class="fas fa-sign-out-alt"></i>', cls: 'bg-secondary' };
        if (action.indexOf('created') >= 0) return { icon: '<i class="fas fa-plus-circle"></i>', cls: 'bg-success' };
        if (action.indexOf('deleted') >= 0) return { icon: '<i class="fas fa-trash"></i>', cls: 'bg-danger' };
        if (action.indexOf('locked') >= 0) return { icon: '<i class="fas fa-lock"></i>', cls: 'bg-warning' };
        if (action.indexOf('unlocked') >= 0) return { icon: '<i class="fas fa-unlock"></i>', cls: 'bg-success' };
        if (action.indexOf('role') >= 0) return { icon: '<i class="fas fa-user-tag"></i>', cls: 'bg-info' };
        if (action.indexOf('password') >= 0) return { icon: '<i class="fas fa-key"></i>', cls: 'bg-warning' };
        if (action.indexOf('simulation') >= 0) return { icon: '<i class="fas fa-play"></i>', cls: 'bg-primary' };
        if (action.indexOf('report') >= 0) return { icon: '<i class="fas fa-file-alt"></i>', cls: 'bg-info' };
        return { icon: '<i class="fas fa-circle"></i>', cls: 'bg-secondary' };
    }

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    $('#btnRefresh').on('click', loadLogs);
    loadLogs();

    // Auto-refresh every 30 seconds
    setInterval(loadLogs, 30000);
})();
</script>
}
