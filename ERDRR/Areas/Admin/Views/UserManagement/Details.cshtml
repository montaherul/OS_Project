@model UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
    var user = Model.User;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-user me-2"></i>@user.FirstName @user.LastName</h2>
        <small class="text-muted">@user.Email</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-primary"><i class="fas fa-edit me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-4">
    <!-- User Info -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-id-card me-2"></i>User Information</h6></div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><td class="text-muted" width="140">User ID</td><td><code>@user.UserId</code></td></tr>
                    <tr><td class="text-muted">Username</td><td>@user.UserName</td></tr>
                    <tr><td class="text-muted">Email</td><td>@user.Email</td></tr>
                    <tr><td class="text-muted">First Name</td><td>@user.FirstName</td></tr>
                    <tr><td class="text-muted">Last Name</td><td>@user.LastName</td></tr>
                    <tr><td class="text-muted">Phone</td><td>@(user.PhoneNumber ?? "N/A")</td></tr>
                    <tr><td class="text-muted">Role</td>
                        <td>
                            @foreach (var role in user.Roles.Split(',', StringSplitOptions.TrimEntries))
                            {
                                <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") me-1">@role</span>
                            }
                        </td>
                    </tr>
                    <tr><td class="text-muted">Status</td>
                        <td>
                            @if (user.Status == "Active") { <span class="badge bg-success">Active</span> }
                            else if (user.Status == "Locked") { <span class="badge bg-warning text-dark">Locked</span> }
                            else { <span class="badge bg-secondary">Inactive</span> }
                        </td>
                    </tr>
                    <tr><td class="text-muted">Created</td><td>@user.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td></tr>
                    <tr><td class="text-muted">Last Login</td><td>@(user.LastLoginAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</td></tr>
                    <tr><td class="text-muted">Failed Logins</td><td>@user.AccessFailedCount</td></tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Process Statistics -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Process Statistics</h6></div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="text-center p-3 bg-light rounded">
                            <h3 class="text-primary mb-0">@user.TotalSessions</h3>
                            <small>Total Sessions</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center p-3 bg-light rounded">
                            <h3 class="text-success mb-0">@user.TotalProcesses</h3>
                            <small>Total Processes</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center p-3 bg-light rounded">
                            <h3 class="text-info mb-0">@user.TotalSimulations</h3>
                            <small>Simulations</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="text-center p-3 bg-light rounded">
                            <h3 class="text-warning mb-0">@user.TotalComparisons</h3>
                            <small>Comparisons</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h6></div>
            <div class="card-body d-flex flex-wrap gap-2">
                @if (user.Status == "Locked")
                {
                    <form method="post" asp-action="Unlock" asp-route-id="@user.UserId">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success btn-sm"><i class="fas fa-unlock me-1"></i>Unlock User</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-action="Lock" asp-route-id="@user.UserId">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning btn-sm"><i class="fas fa-lock me-1"></i>Lock User</button>
                    </form>
                }
                <button type="button" class="btn btn-outline-info btn-sm" data-bs-toggle="modal" data-bs-target="#resetPasswordModal">
                    <i class="fas fa-key me-1"></i>Reset Password
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#roleModal">
                    <i class="fas fa-user-tag me-1"></i>Manage Roles
                </button>
                <form method="post" asp-action="Delete" asp-route-id="@user.UserId" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this user?')">
                        <i class="fas fa-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>

        <!-- Recent Activities -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-history me-2"></i>Recent Activities</h6></div>
            <div class="card-body">
                @if (user.RecentActivities.Any())
                {
                    @foreach (var activity in user.RecentActivities)
                    {
                        <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                            <div>
                                <span class="badge bg-info me-1">@activity.Activity</span>
                                @activity.Details
                            </div>
                            <small class="text-muted">@activity.Timestamp.ToString("MMM dd, HH:mm")</small>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No recent activities.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="ResetPassword" asp-route-id="@user.UserId">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Reset password for <strong>@user.UserName</strong></p>
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input type="password" name="newPassword" class="form-control" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Role Modal -->
<div class="modal fade" id="roleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Manage Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Current roles: <strong>@user.Roles</strong></p>
                <div class="d-flex gap-2 mb-3">
                    <form method="post" asp-action="AssignRole" class="d-flex gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.UserId" />
                        <select name="role" class="form-select form-select-sm">
                            <option value="Admin">Admin</option>
                            <option value="User">User</option>
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary">Assign</button>
                    </form>
                </div>
                @foreach (var role in user.Roles.Split(',', StringSplitOptions.TrimEntries))
                {
                    <form method="post" asp-action="RemoveRole" class="d-inline mb-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" value="@user.UserId" />
                        <input type="hidden" name="role" value="@role" />
                        <span class="badge @(role == "Admin" ? "bg-danger" : "bg-primary") me-1">
                            @role <button type="submit" class="btn-close btn-close-white ms-1" style="font-size:0.6em;" title="Remove"></button>
                        </span>
                    </form>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
