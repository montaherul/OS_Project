@{
    ViewData["Title"] = "Privacy Policy";
}

<h2><i class="fas fa-shield-alt me-2"></i>Privacy Policy</h2>
<p class="lead">Your data is secure with ERDRR.</p>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5>Data Collection</h5>
        <p>ERDRR collects only the necessary information for CPU scheduling simulations, including process configurations and scheduling results.</p>

        <h5>Data Storage</h5>
        <p>All data is stored securely in SQL Server with encrypted connections. Passwords are hashed using industry-standard algorithms.</p>

        <h5>Data Security</h5>
        <ul>
            <li>ASP.NET Core Identity for authentication</li>
            <li>CSRF protection on all forms</li>
            <li>Input validation and sanitization</li>
            <li>SQL injection prevention via parameterized queries</li>
            <li>XSS prevention through output encoding</li>
        </ul>
    </div>
</div>
