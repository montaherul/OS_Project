@{
    ViewData["Title"] = "Session Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-layer-group me-2"></i>Session Management</h2>
        <small class="text-muted" id="showingInfo"></small>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportExcel")"
           class="btn btn-outline-success btn-sm" id="btnExportExcel"><i class="fas fa-file-excel me-1"></i>Export Excel</a>
        <a href="@Url.Action("ExportPdf")"
           class="btn btn-outline-danger btn-sm" id="btnExportPdf"><i class="fas fa-file-pdf me-1"></i>Export PDF</a>
    </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Search</label>
                <input type="text" class="form-control" placeholder="Session name..." id="searchInput" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Algorithm</label>
                <select class="form-select" id="algorithmFilter">
                    <option value="">All Algorithms</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">User</label>
                <select class="form-select" id="userFilter">
                    <option value="">All Users</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Date From</label>
                <input type="date" class="form-control" id="dateFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Date To</label>
                <input type="date" class="form-control" id="dateTo" />
            </div>
            <div class="col-md-1 d-flex align-items-end gap-2">
                <button type="button" class="btn btn-primary w-100" id="btnSearch"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Actions -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body d-flex gap-2 align-items-center">
        <span class="fw-bold"><span id="selectedCount">0</span> selected</span>
        <button type="button" class="btn btn-outline-danger btn-sm" id="btnBulkDelete" disabled>
            <i class="fas fa-trash me-1"></i>Delete
        </button>
    </div>
</div>

<!-- Sessions Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="sessionsTable" class="table table-hover align-middle mb-0" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th width="40"><input type="checkbox" id="selectAll" class="form-check-input" /></th>
                        <th data-sort="sessionName">Session Name</th>
                        <th data-sort="algorithmType">Algorithm</th>
                        <th>Quantum</th>
                        <th>Preemptive</th>
                        <th data-sort="processCount">Processes</th>
                        <th>User</th>
                        <th data-sort="createdAt">Created Date</th>
                        <th data-sort="status">Status</th>
                        <th width="120">Actions</th>
                    </tr>
                </thead>
                <tbody id="sessionsBody"></tbody>
            </table>
        </div>
        <div id="loadingSpinner" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Loading sessions...</p>
        </div>
        <div id="emptyState" class="text-center py-5 d-none">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted mb-0">No sessions found.</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var table = null;
    var selectedIds = new Set();
    var baseUrl = '@Url.Action("Index")' + '/';

    function getAjaxUrl() {
        return '@Url.Action("GetSessions")';
    }

    function initTable() {
        table = $('#sessionsTable').DataTable({
            processing: true,
            serverSide: true,
            pageLength: 10,
            lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
            ajax: {
                url: getAjaxUrl(),
                type: 'GET',
                data: function (d) {
                    d.search = $('#searchInput').val();
                    d.algorithmFilter = $('#algorithmFilter').val();
                    d.userFilter = $('#userFilter').val();
                    d.dateFrom = $('#dateFrom').val() ? new Date($('#dateFrom').val()).toISOString() : null;
                    d.dateTo = $('#dateTo').val() ? new Date($('#dateTo').val() + 'T23:59:59').toISOString() : null;
                    d.sortColumn = getSortColumn(d);
                    d.sortDirection = getSortDirection(d);
                },
                beforeSend: function () {
                    $('#loadingSpinner').removeClass('d-none');
                    $('#sessionsTable').css('opacity', '0.5');
                },
                complete: function () {
                    $('#loadingSpinner').addClass('d-none');
                    $('#sessionsTable').css('opacity', '1');
                    updateShowingInfo();
                },
            },
            columns: [
                {
                    data: 'id',
                    orderable: false,
                    searchable: false,
                    width: '40px',
                    render: function (data) {
                        return '<input type="checkbox" class="form-check-input session-checkbox" value="' + data + '" />';
                    }
                },
                {
                    data: 'sessionName',
                    render: function (data, type, row) {
                        return '<a href="' + baseUrl + 'Details/' + row.id + '" class="fw-bold text-decoration-none">' + escapeHtml(data || '') + '</a>';
                    }
                },
                {
                    data: 'algorithmType',
                    render: function (data) {
                        if (data === 'EDF') return '<span class="badge bg-danger">EDF</span>';
                        if (data === 'RR') return '<span class="badge bg-success">RR</span>';
                        return '<span class="badge bg-primary">' + escapeHtml(data) + '</span>';
                    }
                },
                { data: 'timeQuantum' },
                { data: 'isPreemptive', render: function (d) { return d ? '<i class="fas fa-check text-success"></i>' : '<i class="fas fa-times text-danger"></i>'; } },
                { data: 'processCount' },
                { data: 'createdByName', defaultContent: 'N/A', render: function (d) { return escapeHtml(d || 'N/A'); } },
                {
                    data: 'createdAt',
                    render: function (data) {
                        if (!data) return '';
                        var d = new Date(data);
                        return d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric' });
                    }
                },
                {
                    data: 'status',
                    render: function (data) {
                        if (data === 'Created') return '<span class="badge bg-info">Created</span>';
                        if (data === 'Running') return '<span class="badge bg-success">Running</span>';
                        if (data === 'Completed') return '<span class="badge bg-secondary">Completed</span>';
                        return '<span class="badge bg-secondary">' + escapeHtml(data) + '</span>';
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    searchable: false,
                    width: '120px',
                    render: function (data) {
                        return '<div class="btn-group btn-group-sm">' +
                            '<a href="' + baseUrl + 'Details/' + data + '" class="btn btn-outline-info" title="Details"><i class="fas fa-eye"></i></a>' +
                            '<button type="button" class="btn btn-outline-danger btn-delete-session" data-id="' + data + '" title="Delete"><i class="fas fa-trash"></i></button>' +
                            '</div>';
                    }
                }
            ],
            order: [[7, 'desc']],
            language: {
                emptyTable: 'No sessions found.',
                zeroRecords: 'No matching sessions found.',
                processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>'
            },
            drawCallback: function () {
                syncCheckboxes();
            }
        });
    }

    function getSortColumn(d) {
        if (!d.order || !d.order.length) return 'createdAt';
        var colIdx = d.order[0].column;
        var map = { 1: 'sessionName', 2: 'algorithmType', 5: 'processCount', 7: 'createdAt', 8: 'status' };
        return map[colIdx] || 'createdAt';
    }

    function getSortDirection(d) {
        if (!d.order || !d.order.length) return 'desc';
        return d.order[0].dir === 'asc' ? 'ASC' : 'DESC';
    }

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    function updateShowingInfo() {
        var info = table.page.info();
        if (info) {
            $('#showingInfo').text('Showing ' + (info.start + 1) + '-' + info.end + ' of ' + info.recordsTotal + ' sessions');
        }
    }

    function syncCheckboxes() {
        var anyChecked = false;
        $('#sessionsBody .session-checkbox').each(function () {
            if (selectedIds.has(this.value)) { this.checked = true; anyChecked = true; }
            else { this.checked = false; }
        });
        $('#selectAll').prop('checked', anyChecked && $('#sessionsBody .session-checkbox:checked').length === $('#sessionsBody .session-checkbox').length);
        updateSelectedCount();
    }

    function updateSelectedCount() {
        var count = selectedIds.size;
        $('#selectedCount').text(count);
        $('#btnBulkDelete').prop('disabled', count === 0);
    }

    // Load filter options
    $.get('@Url.Action("GetFilterOptions")', function (res) {
        if (res.algorithms) {
            res.algorithms.forEach(function (a) {
                $('#algorithmFilter').append('<option value="' + a.value + '">' + escapeHtml(a.label) + '</option>');
            });
        }
        if (res.users) {
            res.users.forEach(function (u) {
                $('#userFilter').append('<option value="' + u.value + '">' + escapeHtml(u.label) + '</option>');
            });
        }
    });

    // Search
    $('#btnSearch').on('click', function () { selectedIds.clear(); table.ajax.reload(null, true); });
    $('#searchInput, #dateFrom, #dateTo, #algorithmFilter, #userFilter').on('keyup change', function (e) {
        if (e.type === 'keyup' && e.key !== 'Enter') return;
        selectedIds.clear();
        table.ajax.reload(null, true);
    });

    // Select All
    $('#selectAll').on('change', function () {
        var checked = this.checked;
        $('#sessionsBody .session-checkbox').each(function () {
            this.checked = checked;
            if (checked) selectedIds.add(this.value); else selectedIds.delete(this.value);
        });
        updateSelectedCount();
    });

    $('#sessionsBody').on('change', '.session-checkbox', function () {
        if (this.checked) selectedIds.add(this.value); else selectedIds.delete(this.value);
        var total = $('#sessionsBody .session-checkbox').length;
        var checked = $('#sessionsBody .session-checkbox:checked').length;
        $('#selectAll').prop('checked', total > 0 && checked === total);
        updateSelectedCount();
    });

    var token = $('input[name="__RequestVerificationToken"]').first().val() || '';
    var bulkUrl = '@Url.Action("BulkAction")';

    $('#btnBulkDelete').on('click', function () {
        if (!selectedIds.size) return;
        Swal.fire({
            title: 'Delete ' + selectedIds.size + ' session(s)?',
            text: 'This will soft-delete the selected sessions.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Yes, delete them!'
        }).then(function (result) {
            if (result.isConfirmed) {
                Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                $.ajax({
                    url: bulkUrl + '?action=delete',
                    type: 'POST',
                    data: { selectedIds: Array.from(selectedIds), __RequestVerificationToken: token },
                    traditional: true
                }).done(function (res) {
                    selectedIds.clear();
                    table.ajax.reload(null, true);
                    Swal.fire('Deleted!', res.message || 'Sessions deleted.', 'success');
                }).fail(function () { Swal.fire('Error', 'Failed to delete sessions.', 'error'); });
            }
        });
    });

    $('#sessionsTable').on('click', '.btn-delete-session', function () {
        var id = $(this).data('id');
        Swal.fire({
            title: 'Delete this session?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Delete'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Delete")/' + id,
                    type: 'POST',
                    data: { __RequestVerificationToken: token }
                }).done(function () {
                    table.ajax.reload(null, true);
                    Swal.fire('Deleted!', 'Session deleted.', 'success');
                }).fail(function () { Swal.fire('Error', 'Failed to delete session.', 'error'); });
            }
        });
    });

    initTable();
})();
</script>
}
