@model CreateUserViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title"><i class="fas fa-user-plus me-2"></i>Create User</h1>
        <p class="page-header__subtitle">Add a new user account</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn-ghost">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row animate-in">
    <div class="col-lg-8">
        <div class="card-edfrr">
            <div class="card-edfrr__header">
                <h5><i class="fas fa-user-cog me-2"></i>User Information</h5>
            </div>
            <div class="card-edfrr__body">
                <form method="post" asp-action="Create">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:13px;"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="edfrr-label">First Name <span style="color:var(--color-danger)">*</span></label>
                            <input asp-for="FirstName" class="edfrr-input" required />
                            <span asp-validation-for="FirstName" class="text-danger" style="font-size:11px;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="edfrr-label">Last Name <span style="color:var(--color-danger)">*</span></label>
                            <input asp-for="LastName" class="edfrr-input" required />
                            <span asp-validation-for="LastName" class="text-danger" style="font-size:11px;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="edfrr-label">Email <span style="color:var(--color-danger)">*</span></label>
                            <input asp-for="Email" class="edfrr-input" type="email" required />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:11px;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="edfrr-label">Password <span style="color:var(--color-danger)">*</span></label>
                            <input asp-for="Password" class="edfrr-input" type="password" required />
                            <span asp-validation-for="Password" class="text-danger" style="font-size:11px;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="edfrr-label">Phone Number</label>
                            <input asp-for="PhoneNumber" class="edfrr-input" />
                            <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:11px;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="edfrr-label">Role <span style="color:var(--color-danger)">*</span></label>
                            <select asp-for="Role" class="edfrr-select">
                                <option value="User">User</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-12" style="border-top:1px solid var(--border-subtle);padding-top:var(--space-4);">
                            <button type="submit" class="btn-primary"><i class="fas fa-save"></i> Create User</button>
                            <a asp-action="Index" class="btn-ghost ms-2">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
