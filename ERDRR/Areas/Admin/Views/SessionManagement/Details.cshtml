@model AdminSessionDetailDto
@{
    ViewData["Title"] = "Session Details";
    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-info-circle me-2"></i>Session Details</h2>
        <small class="text-muted">@Model.SessionName</small>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<!-- Session Info Card -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-cog me-2"></i>Session Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered mb-0">
                    <tbody>
                        <tr><th class="bg-light" style="width:160px">Name</th><td>@Model.SessionName</td></tr>
                        <tr><th class="bg-light">Description</th><td>@(Model.Description ?? "N/A")</td></tr>
                        <tr><th class="bg-light">Algorithm</th><td><span class="badge bg-info fs-6">@Model.AlgorithmType</span></td></tr>
                        <tr><th class="bg-light">Time Quantum</th><td>@Model.TimeQuantum</td></tr>
                        <tr><th class="bg-light">Preemptive</th><td>@(Model.IsPreemptive ? "Yes" : "No")</td></tr>
                        <tr><th class="bg-light">Status</th><td><span class="badge @(Model.Status == "Completed" ? "bg-success" : Model.Status == "Running" ? "bg-primary" : "bg-secondary")">@Model.Status</span></td></tr>
                        <tr><th class="bg-light">Created By</th><td>@(Model.CreatedByName ?? "N/A")</td></tr>
                        <tr><th class="bg-light">Created At</th><td>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Performance Metrics -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Performance Metrics</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-primary mb-1">@Model.CpuUtilization.ToString("F1")%</h5>
                            <small class="text-muted">CPU Utilization</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-success mb-1">@Model.Throughput.ToString("F2")</h5>
                            <small class="text-muted">Throughput</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-info mb-1">@Model.AverageWaitingTime.ToString("F1")</h5>
                            <small class="text-muted">Avg Waiting Time</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-warning mb-1">@Model.AverageTurnaroundTime.ToString("F1")</h5>
                            <small class="text-muted">Avg Turnaround Time</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-secondary mb-1">@Model.AverageResponseTime.ToString("F1")</h5>
                            <small class="text-muted">Avg Response Time</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-danger mb-1">@Model.ContextSwitchCount</h5>
                            <small class="text-muted">Context Switches</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-danger mb-1">@Model.TotalProcesses</h5>
                            <small class="text-muted">Total Processes</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded bg-light text-center">
                            <h5 class="text-@(Model.DeadlineMissRatio > 50 ? "danger" : "success") mb-1">@Model.DeadlineMissRatio.ToString("F1")%</h5>
                            <small class="text-muted">Deadline Miss Ratio</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gantt Chart -->
@if (Model.GanttChart.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-chart-gantt me-2"></i>Gantt Chart</h5>
        </div>
        <div class="card-body">
            <div class="gantt-container" style="overflow-x:auto; position:relative;">
                <div id="ganttChart" style="min-height:80px; position:relative;"></div>
            </div>
        </div>
    </div>
}

<!-- Processes Table -->
@if (Model.Processes.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>Process Results (@Model.Processes.Count)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Process ID</th>
                            <th>Name</th>
                            <th>Arrival</th>
                            <th>Burst</th>
                            <th>Deadline</th>
                            <th>Completion</th>
                            <th>WT</th>
                            <th>TAT</th>
                            <th>RT</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Processes)
                        {
                            <tr>
                                <td><code>@p.ProcessId</code></td>
                                <td>@p.ProcessName</td>
                                <td>@p.ArrivalTime</td>
                                <td>@p.BurstTime</td>
                                <td>@p.Deadline</td>
                                <td>@p.CompletionTime</td>
                                <td>@p.WaitingTime</td>
                                <td>@p.TurnaroundTime</td>
                                <td>@p.ResponseTime</td>
                                <td>
                                    @if (p.IsMissedDeadline)
                                    {
                                        <span class="badge bg-danger">Deadline Missed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted mb-0">No simulation results available for this session.</p>
        </div>
    </div>
}

@section Scripts {
<script>
    var ganttData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GanttChart, jsonOptions));

    if (ganttData && ganttData.length) {
        var container = document.getElementById('ganttChart');
        var maxEnd = Math.max.apply(null, ganttData.map(function(e) { return e.endTime; }));
        var totalWidth = Math.max((maxEnd + 1) * 60, 600);
        container.style.width = totalWidth + 'px';

        var html = '<div style="display:flex; align-items:center; gap:2px;">';
        ganttData.forEach(function(entry, idx) {
            var width = Math.max((entry.endTime - entry.startTime) * 60 - 2, 20);
            var label = entry.processName || entry.processId;
            html += '<div style="width:' + width + 'px; height:50px; background:' + entry.color + '; border-radius:4px; display:flex; align-items:center; justify-content:center; color:white; font-size:11px; font-weight:bold; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding:0 4px;" title="' + label + ' (' + entry.startTime + '-' + entry.endTime + ')">' +
                    label +
                    '</div>';
        });
        html += '</div>';
        container.innerHTML = html;
    }
</script>
}
