@model ERDRR.Models.ViewModels.SchedulerComparisonViewModel
@{
    ViewData["Title"] = "Scheduler Comparison";
    var result = Model.Result;
    var hasResult = result != null;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-balance-scale me-2"></i>Scheduler Comparison</h2>
        <small class="text-muted">Compare EDF, RR, and Hybrid EDF+RR on the same process dataset</small>
    </div>
</div>

<!-- Session Selector -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="post" asp-action="RunComparison" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <label class="form-label fw-bold">Select Session</label>
                <select name="sessionId" class="form-select" id="sessionSelect">
                    <option value="">-- Select a Session --</option>
                    @foreach (var session in Model.Sessions)
                    {
                        <option value="@session.Id" selected="@(Model.SelectedSessionId == session.Id)">
                            @session.Name (@session.AlgorithmType) - @session.CreatedAt.ToString("MMM dd, yyyy")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100" id="runBtn">
                    <i class="fas fa-play me-1"></i>Run Comparison
                </button>
            </div>
        </form>
    </div>
</div>

@if (hasResult)
{
    <!-- Session Info Banner -->
    <div class="card border-0 shadow-sm mb-4 bg-dark text-white">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <small class="text-white-50">Session</small>
                    <h5 class="mb-0">@result.SessionName</h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Processes</small>
                    <h5 class="mb-0">@result.ProcessCount</h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Time Quantum</small>
                    <h5 class="mb-0">@result.TimeQuantum</h5>
                </div>
                <div class="col-md-2">
                    <small class="text-white-50">Preemptive</small>
                    <h5 class="mb-0">@(result.IsPreemptive ? "Yes" : "No")</h5>
                </div>
                <div class="col-md-3">
                    <small class="text-white-50">Compared</small>
                    <h5 class="mb-0">@result.CreatedAt.ToString("MMM dd, yyyy HH:mm")</h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Recommendation Card -->
    <div class="card border-0 shadow-sm mb-4 border-start border-4 border-warning">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-1 text-center">
                    <i class="fas fa-trophy fa-3x text-warning"></i>
                </div>
                <div class="col-md-8">
                    <h5 class="mb-1">Best Algorithm: <span class="text-primary">@result.RecommendedAlgorithm</span></h5>
                    <p class="mb-0 text-muted">@result.RecommendationReason</p>
                </div>
                <div class="col-md-3 text-end">
                    <div class="d-inline-block bg-primary text-white rounded-pill px-3 py-2">
                        <small>Performance Score</small>
                        <h4 class="mb-0">@result.BestScore.ToString("F1")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Comparison Table -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-table me-2"></i>Performance Metrics Comparison</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Metric</th>
                            <th class="text-center">EDF</th>
                            <th class="text-center">RR</th>
                            <th class="text-center">Hybrid EDF+RR</th>
                            <th class="text-center">Best</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var metrics = new[] {
                            ("Avg Waiting Time", result.EDF.WaitingTime, result.RR.WaitingTime, result.Hybrid.WaitingTime, "lower"),
                            ("Avg Turnaround Time", result.EDF.TurnaroundTime, result.RR.TurnaroundTime, result.Hybrid.TurnaroundTime, "lower"),
                            ("Avg Response Time", result.EDF.ResponseTime, result.RR.ResponseTime, result.Hybrid.ResponseTime, "lower"),
                            ("CPU Utilization %", result.EDF.CpuUtilization, result.RR.CpuUtilization, result.Hybrid.CpuUtilization, "higher"),
                            ("Throughput", result.EDF.Throughput, result.RR.Throughput, result.Hybrid.Throughput, "higher"),
                            ("Context Switches", (double)result.EDF.ContextSwitches, (double)result.RR.ContextSwitches, (double)result.Hybrid.ContextSwitches, "lower"),
                            ("Deadline Miss Ratio %", result.EDF.DeadlineMissRatio, result.RR.DeadlineMissRatio, result.Hybrid.DeadlineMissRatio, "lower")
                        }; }
                        @foreach (var (name, edf, rr, hybrid, pref) in metrics)
                        {
                            var vals = new[] { edf, rr, hybrid };
                            var best = pref == "lower" ? vals.Min() : vals.Max();
                            var bestName = best == edf ? "EDF" : best == rr ? "RR" : "Hybrid";
                            <tr>
                                <td class="fw-bold">@name</td>
                                <td class="text-center @(edf == best ? "table-success fw-bold" : "")">@edf.ToString("F2")</td>
                                <td class="text-center @(rr == best ? "table-success fw-bold" : "")">@rr.ToString("F2")</td>
                                <td class="text-center @(hybrid == best ? "table-success fw-bold" : "")">@hybrid.ToString("F2")</td>
                                <td class="text-center"><span class="badge bg-success">@bestName</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Charts -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-clock me-2"></i>Waiting Time Comparison</h6></div>
                <div class="card-body"><canvas id="waitingChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-hourglass-half me-2"></i>Turnaround Time Comparison</h6></div>
                <div class="card-body"><canvas id="turnaroundChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Response Time Comparison</h6></div>
                <div class="card-body"><canvas id="responseChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-microchip me-2"></i>CPU Utilization Comparison</h6></div>
                <div class="card-body"><canvas id="cpuChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Deadline Miss Ratio</h6></div>
                <div class="card-body"><canvas id="deadlineChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h6 class="mb-0"><i class="fas fa-chart-radar me-2"></i>Overall Performance Radar</h6></div>
                <div class="card-body"><canvas id="radarChart"></canvas></div>
            </div>
        </div>
    </div>

    <!-- Export -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body d-flex gap-2">
            <form method="post" asp-action="ExportComparisonReport">
                @Html.AntiForgeryToken()
                <input type="hidden" name="comparisonId" value="@result.Id" />
                <input type="hidden" name="format" value="excel" />
                <button type="submit" class="btn btn-outline-success"><i class="fas fa-file-excel me-1"></i>Export CSV</button>
            </form>
            <form method="post" asp-action="Delete" asp-route-sessionId="@result.SessionId">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@result.Id" />
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Delete this comparison?')"><i class="fas fa-trash me-1"></i>Delete</button>
            </form>
        </div>
    </div>

    @section Scripts {
    <script>
        (function () {
            var result = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(result, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

            var labels = ['EDF', 'RR', 'Hybrid EDF+RR'];
            var colors = {
                edf: 'rgba(13, 110, 253, 0.8)',
                rr: 'rgba(255, 193, 7, 0.8)',
                hybrid: 'rgba(40, 167, 69, 0.8)'
            };

            var waitingChartData = {
                labels: labels,
                datasets: [{
                    label: 'Avg Waiting Time',
                    data: [result.edf.waitingTime, result.rr.waitingTime, result.hybrid.waitingTime],
                    backgroundColor: [colors.edf, colors.rr, colors.hybrid],
                    borderColor: ['rgba(13,110,253,1)', 'rgba(255,193,7,1)', 'rgba(40,167,69,1)'],
                    borderWidth: 1
                }]
            };

            var turnaroundChartData = {
                labels: labels,
                datasets: [{
                    label: 'Avg Turnaround Time',
                    data: [result.edf.turnaroundTime, result.rr.turnaroundTime, result.hybrid.turnaroundTime],
                    backgroundColor: [colors.edf, colors.rr, colors.hybrid],
                    borderColor: ['rgba(13,110,253,1)', 'rgba(255,193,7,1)', 'rgba(40,167,69,1)'],
                    borderWidth: 1
                }]
            };

            var responseChartData = {
                labels: labels,
                datasets: [{
                    label: 'Avg Response Time',
                    data: [result.edf.responseTime, result.rr.responseTime, result.hybrid.responseTime],
                    backgroundColor: [colors.edf, colors.rr, colors.hybrid],
                    borderColor: ['rgba(13,110,253,1)', 'rgba(255,193,7,1)', 'rgba(40,167,69,1)'],
                    borderWidth: 1
                }]
            };

            var cpuChartData = {
                labels: labels,
                datasets: [{
                    label: 'CPU Utilization %',
                    data: [result.edf.cpuUtilization, result.rr.cpuUtilization, result.hybrid.cpuUtilization],
                    backgroundColor: [colors.edf, colors.rr, colors.hybrid],
                    borderColor: ['rgba(13,110,253,1)', 'rgba(255,193,7,1)', 'rgba(40,167,69,1)'],
                    borderWidth: 1
                }]
            };

            var deadlineChartData = {
                labels: labels,
                datasets: [{
                    label: 'Deadline Miss Ratio %',
                    data: [result.edf.deadlineMissRatio, result.rr.deadlineMissRatio, result.hybrid.deadlineMissRatio],
                    backgroundColor: [colors.edf, colors.rr, colors.hybrid],
                    borderColor: ['rgba(13,110,253,1)', 'rgba(255,193,7,1)', 'rgba(40,167,69,1)'],
                    borderWidth: 1
                }]
            };

            var barOptions = {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, title: { display: true, text: 'Time (units)' } },
                    x: { title: { display: true, text: 'Algorithm' } }
                },
                plugins: {
                    legend: { display: true, position: 'top' },
                    tooltip: { enabled: true, mode: 'index', intersect: false }
                }
            };

            function destroyIfExists(canvasId) {
                var existing = Chart.getChart(canvasId);
                if (existing) existing.destroy();
            }

            destroyIfExists('waitingChart');
            destroyIfExists('turnaroundChart');
            destroyIfExists('responseChart');
            destroyIfExists('cpuChart');
            destroyIfExists('deadlineChart');
            destroyIfExists('radarChart');

            var waitingEl = document.getElementById('waitingChart');
            if (waitingEl) {
                new Chart(waitingEl.getContext('2d'), {
                    type: 'bar',
                    data: waitingChartData,
                    options: barOptions
                });
            }

            var turnaroundEl = document.getElementById('turnaroundChart');
            if (turnaroundEl) {
                new Chart(turnaroundEl.getContext('2d'), {
                    type: 'bar',
                    data: turnaroundChartData,
                    options: barOptions
                });
            }

            var responseEl = document.getElementById('responseChart');
            if (responseEl) {
                new Chart(responseEl.getContext('2d'), {
                    type: 'bar',
                    data: responseChartData,
                    options: barOptions
                });
            }

            var cpuEl = document.getElementById('cpuChart');
            if (cpuEl) {
                new Chart(cpuEl.getContext('2d'), {
                    type: 'bar',
                    data: cpuChartData,
                    options: barOptions
                });
            }

            var deadlineEl = document.getElementById('deadlineChart');
            if (deadlineEl) {
                new Chart(deadlineEl.getContext('2d'), {
                    type: 'bar',
                    data: deadlineChartData,
                    options: barOptions
                });
            }

            var maxWaiting = Math.max(result.edf.waitingTime, result.rr.waitingTime, result.hybrid.waitingTime, 1);
            var maxTurnaround = Math.max(result.edf.turnaroundTime, result.rr.turnaroundTime, result.hybrid.turnaroundTime, 1);
            var maxResponse = Math.max(result.edf.responseTime, result.rr.responseTime, result.hybrid.responseTime, 1);

            var radarEl = document.getElementById('radarChart');
            if (radarEl) {
                new Chart(radarEl.getContext('2d'), {
                    type: 'radar',
                    data: {
                        labels: ['Waiting (inv)', 'Turnaround (inv)', 'Response (inv)', 'CPU Utilization', 'Throughput (x1000)'],
                        datasets: [
                            {
                                label: 'EDF',
                                data: [
                                    (maxWaiting - result.edf.waitingTime) / maxWaiting * 100,
                                    (maxTurnaround - result.edf.turnaroundTime) / maxTurnaround * 100,
                                    (maxResponse - result.edf.responseTime) / maxResponse * 100,
                                    result.edf.cpuUtilization,
                                    result.edf.throughput * 1000
                                ],
                                borderColor: colors.edf,
                                backgroundColor: 'rgba(13, 110, 253, 0.15)',
                                pointBackgroundColor: colors.edf,
                                borderWidth: 2
                            },
                            {
                                label: 'RR',
                                data: [
                                    (maxWaiting - result.rr.waitingTime) / maxWaiting * 100,
                                    (maxTurnaround - result.rr.turnaroundTime) / maxTurnaround * 100,
                                    (maxResponse - result.rr.responseTime) / maxResponse * 100,
                                    result.rr.cpuUtilization,
                                    result.rr.throughput * 1000
                                ],
                                borderColor: colors.rr,
                                backgroundColor: 'rgba(255, 193, 7, 0.15)',
                                pointBackgroundColor: colors.rr,
                                borderWidth: 2
                            },
                            {
                                label: 'Hybrid',
                                data: [
                                    (maxWaiting - result.hybrid.waitingTime) / maxWaiting * 100,
                                    (maxTurnaround - result.hybrid.turnaroundTime) / maxTurnaround * 100,
                                    (maxResponse - result.hybrid.responseTime) / maxResponse * 100,
                                    result.hybrid.cpuUtilization,
                                    result.hybrid.throughput * 1000
                                ],
                                borderColor: colors.hybrid,
                                backgroundColor: 'rgba(40, 167, 69, 0.15)',
                                pointBackgroundColor: colors.hybrid,
                                borderWidth: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                beginAtZero: true,
                                max: 100,
                                ticks: { stepSize: 20 },
                                pointLabels: { font: { size: 11 } }
                            }
                        },
                        plugins: {
                            legend: { position: 'bottom' },
                            tooltip: { enabled: true }
                        }
                    }
                });
            }
        })();
    </script>
    }
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-balance-scale fa-3x text-muted mb-3"></i>
            <h4>No Comparison Results</h4>
            <p class="text-muted">Select a session and click "Run Comparison" to compare scheduling algorithms.</p>
        </div>
    </div>
}
