@page
@model EDFRR.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center animate-in" style="margin-top:60px;">
    <div class="col-md-5 col-lg-4 text-center">
        <div style="width:64px;height:64px;border-radius:50%;background:var(--color-danger-alpha);display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
            <i class="fas fa-shield-halved" style="color:var(--color-danger);font-size:28px;"></i>
        </div>
        <h2 style="font-size:22px;font-weight:700;margin-bottom:8px;">Access Denied</h2>
        <p style="font-size:14px;color:var(--text-secondary);margin-bottom:24px;">
            You do not have permission to access this area.<br>
            Please contact an administrator if you believe this is a mistake.
        </p>
        <a asp-area="" asp-controller="Dashboard" asp-action="Index" class="btn-primary">
            <i class="fas fa-tachometer-alt me-1"></i> Go to Dashboard
        </a>
    </div>
</div>