@model ERDRR.Models.ViewModels.ProcessListViewModel
@{
    ViewData["Title"] = $"Processes - {Model.SessionName}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-list me-2"></i>Processes</h2>
        <small class="text-muted">Session: @Model.SessionName | Total: @Model.TotalItems processes</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-sessionId="@Model.SessionId" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Add Process
        </a>
        <a asp-action="Import" asp-route-sessionId="@Model.SessionId" class="btn btn-info text-white">
            <i class="fas fa-file-import me-1"></i>Import
        </a>
        <form asp-action="BulkAdd" asp-route-sessionId="@Model.SessionId" method="post" class="d-flex gap-1">
            <input type="number" name="count" value="5" min="1" max="20" class="form-control form-control-sm" style="width:80px" />
            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Add random processes?')">
                <i class="fas fa-random me-1"></i>Bulk Add
            </button>
        </form>
        <a asp-controller="Simulation" asp-action="Index" asp-route-sessionId="@Model.SessionId" class="btn btn-success">
            <i class="fas fa-play me-1"></i>Simulate
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <input type="hidden" name="sessionId" value="@Model.SessionId" />
            <div class="col-md-5">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search processes..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Pending">Pending</option>
                    <option value="Running">Running</option>
                    <option value="Completed">Completed</option>
                    <option value="MissedDeadline">Missed Deadline</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-filter me-1"></i>Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" asp-route-sessionId="@Model.SessionId" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        @if (Model.Processes.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>PID</th>
                            <th>Name</th>
                            <th>Arrival Time</th>
                            <th>Burst Time</th>
                            <th>Deadline</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var process in Model.Processes)
                        {
                            <tr>
                                <td><code>@process.ProcessId</code></td>
                                <td>@process.Name</td>
                                <td>@process.ArrivalTime</td>
                                <td>@process.BurstTime</td>
                                <td>@process.Deadline</td>
                                <td>@process.Priority</td>
                                <td>
                                    @switch (process.Status)
                                    {
                                        case "Completed":
                                            <span class="badge bg-success">Completed</span>
                                            break;
                                        case "Running":
                                            <span class="badge bg-primary">Running</span>
                                            break;
                                        case "MissedDeadline":
                                            <span class="badge bg-danger">Missed Deadline</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Pending</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@process.Id" class="btn btn-outline-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@process.Id" asp-route-sessionId="@Model.SessionId" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete"
                                                    onclick="return confirm('Delete this process?')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-sessionId="@Model.SessionId"
                                   asp-route-page="@i" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.FilterStatus">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">No processes yet. Add processes to this session.</p>
                <a asp-action="Create" asp-route-sessionId="@Model.SessionId" class="btn btn-primary">Add First Process</a>
            </div>
        }
    </div>
</div>
