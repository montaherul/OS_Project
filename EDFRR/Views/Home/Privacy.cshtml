@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="card-edfrr animate-in" style="max-width:800px;margin:40px auto;">
    <div class="card-edfrr__header">
        <h5><i class="fas fa-shield-alt me-2"></i>Privacy Policy</h5>
    </div>
    <div class="card-edfrr__body">
        <h6 style="font-size:14px;margin-bottom:6px;">Data Collection</h6>
        <p style="font-size:13px;color:var(--text-secondary);">EDFRR collects only the necessary information for CPU scheduling simulations, including process configurations and scheduling results.</p>

        <h6 style="font-size:14px;margin:var(--space-4) 0 6px;">Data Storage</h6>
        <p style="font-size:13px;color:var(--text-secondary);">All data is stored securely in SQL Server with encrypted connections. Passwords are hashed using industry-standard algorithms.</p>

        <h6 style="font-size:14px;margin:var(--space-4) 0 6px;">Data Security</h6>
        <ul style="font-size:13px;color:var(--text-secondary);padding-left:var(--space-4);">
            <li>ASP.NET Core Identity for authentication</li>
            <li>CSRF protection on all forms</li>
            <li>Input validation and sanitization</li>
            <li>SQL injection prevention via parameterized queries</li>
            <li>XSS prevention through output encoding</li>
        </ul>
    </div>
</div>
