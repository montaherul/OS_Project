@model ERDRR.Models.ViewModels.ProcessCreateViewModel
@{
    ViewData["Title"] = "Add Process";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="fas fa-plus me-2"></i>Add Process</h4>
            </div>
            <div class="card-body">
                <p class="text-muted">Session: <strong>@Model.SessionName</strong></p>
                <form asp-action="Create" method="post">
                    <input type="hidden" asp-for="SchedulingSessionId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Process Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g., Process A" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="ArrivalTime" class="form-label">Arrival Time *</label>
                            <input asp-for="ArrivalTime" class="form-control" type="number" min="0" />
                            <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="BurstTime" class="form-label">Burst Time *</label>
                            <input asp-for="BurstTime" class="form-control" type="number" min="1" />
                            <span asp-validation-for="BurstTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Deadline" class="form-label">Deadline *</label>
                            <input asp-for="Deadline" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Deadline" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Priority" class="form-label">Priority</label>
                        <input asp-for="Priority" class="form-control" type="number" min="0" max="10" />
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Add Process
                        </button>
                        <a asp-action="Index" asp-route-sessionId="@Model.SchedulingSessionId" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
