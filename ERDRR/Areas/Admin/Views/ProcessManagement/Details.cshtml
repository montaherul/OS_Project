@model AdminProcessDetailDto
@{
    ViewData["Title"] = "Process Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-info-circle me-2"></i>Process Details</h2>
        <small class="text-muted">@Model.ProcessName (@Model.ProcessId)</small>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-cog me-2"></i>Process Information</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered mb-0">
                    <tbody>
                        <tr>
                            <th class="bg-light" style="width:180px">ID</th>
                            <td>@Model.Id</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Process Name</th>
                            <td>@Model.ProcessName</td>
                        </tr>
                        <tr>
                            <th class="bg-light">PID</th>
                            <td><code>@Model.ProcessId</code></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Arrival Time</th>
                            <td>@Model.ArrivalTime</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Burst Time</th>
                            <td>@Model.BurstTime</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Deadline</th>
                            <td>@Model.Deadline</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Priority</th>
                            <td>@Model.Priority</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Status</th>
                            <td>
                                @switch (Model.Status)
                                {
                                    case "Pending": <span class="badge bg-warning text-dark">Pending</span>; break;
                                    case "Running": <span class="badge bg-success">Running</span>; break;
                                    case "Completed": <span class="badge bg-info">Completed</span>; break;
                                    default: <span class="badge bg-secondary">@Model.Status</span>; break;
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-user me-2"></i>User & Session</h5>
            </div>
            <div class="card-body">
                <table class="table table-bordered mb-0">
                    <tbody>
                        <tr>
                            <th class="bg-light" style="width:180px">Created By</th>
                            <td>@(Model.CreatedByName ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Email</th>
                            <td>@(Model.CreatedByEmail ?? "N/A")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Session</th>
                            <td>@Model.SessionName</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Algorithm</th>
                            <td><span class="badge bg-info">@Model.AlgorithmType</span></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Created At</th>
                            <td>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm:ss")</td>
                        </tr>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <tr>
                                <th class="bg-light">Updated At</th>
                                <td>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.CompletionTime.HasValue)
{
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Execution Results</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 rounded bg-light text-center">
                        <h4 class="text-success mb-1">@Model.CompletionTime</h4>
                        <small class="text-muted">Completion Time</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-light text-center">
                        <h4 class="text-info mb-1">@Model.TurnaroundTime</h4>
                        <small class="text-muted">Turnaround Time</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-light text-center">
                        <h4 class="text-warning mb-1">@Model.WaitingTime</h4>
                        <small class="text-muted">Waiting Time</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-light text-center">
                        <h4 class="text-danger mb-1">@Model.ResponseTime</h4>
                        <small class="text-muted">Response Time</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
