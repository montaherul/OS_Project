@{
    ViewData["Title"] = "Process Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-list me-2"></i>Process Management</h2>
        <small class="text-muted" id="showingInfo"></small>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportExcel")"
           class="btn btn-outline-success btn-sm" id="btnExportExcel"><i class="fas fa-file-excel me-1"></i>Export Excel</a>
        <a href="@Url.Action("ExportPdf")"
           class="btn btn-outline-danger btn-sm" id="btnExportPdf"><i class="fas fa-file-pdf me-1"></i>Export PDF</a>
    </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Search</label>
                <input type="text" class="form-control" placeholder="Name, PID..." id="searchInput" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">User</label>
                <select class="form-select" id="userFilter">
                    <option value="">All Users</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Status</label>
                <select class="form-select" id="statusFilter">
                    <option value="">All Status</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Date From</label>
                <input type="date" class="form-control" id="dateFrom" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Date To</label>
                <input type="date" class="form-control" id="dateTo" />
            </div>
            <div class="col-md-1 d-flex align-items-end gap-2">
                <button type="button" class="btn btn-primary w-100" id="btnSearch"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Actions -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body d-flex gap-2 align-items-center">
        <span class="fw-bold"><span id="selectedCount">0</span> selected</span>
        <button type="button" class="btn btn-outline-danger btn-sm" id="btnBulkDelete" disabled>
            <i class="fas fa-trash me-1"></i>Delete
        </button>
    </div>
</div>

<!-- Processes Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="processesTable" class="table table-hover align-middle mb-0" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th width="40"><input type="checkbox" id="selectAll" class="form-check-input" /></th>
                        <th data-sort="processName">Process Name</th>
                        <th>PID</th>
                        <th data-sort="arrivalTime">Arrival</th>
                        <th data-sort="burstTime">Burst</th>
                        <th>Deadline</th>
                        <th>Priority</th>
                        <th data-sort="status">Status</th>
                        <th>User</th>
                        <th data-sort="createdAt">Created Date</th>
                        <th width="120">Actions</th>
                    </tr>
                </thead>
                <tbody id="processesBody"></tbody>
            </table>
        </div>
        <div id="loadingSpinner" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-muted mt-2 mb-0">Loading processes...</p>
        </div>
        <div id="emptyState" class="text-center py-5 d-none">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted mb-0">No processes found.</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var table = null;
    var selectedIds = new Set();
    var baseUrl = '@Url.Action("Index")' + '/';

    function getAjaxUrl() {
        return '@Url.Action("GetProcesses")';
    }

    function initTable() {
        table = $('#processesTable').DataTable({
            processing: true,
            serverSide: true,
            pageLength: 10,
            lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
            ajax: {
                url: getAjaxUrl(),
                type: 'GET',
                data: function (d) {
                    d.search = $('#searchInput').val();
                    d.userFilter = $('#userFilter').val();
                    d.statusFilter = $('#statusFilter').val();
                    d.dateFrom = $('#dateFrom').val() ? new Date($('#dateFrom').val()).toISOString() : null;
                    d.dateTo = $('#dateTo').val() ? new Date($('#dateTo').val() + 'T23:59:59').toISOString() : null;
                    d.sortColumn = getSortColumn(d);
                    d.sortDirection = getSortDirection(d);
                },
                beforeSend: function () {
                    $('#loadingSpinner').removeClass('d-none');
                    $('#processesTable').css('opacity', '0.5');
                },
                complete: function () {
                    $('#loadingSpinner').addClass('d-none');
                    $('#processesTable').css('opacity', '1');
                    updateShowingInfo();
                    updateExportLinks();
                },
            },
            columns: [
                {
                    data: 'id',
                    orderable: false,
                    searchable: false,
                    width: '40px',
                    render: function (data) {
                        return '<input type="checkbox" class="form-check-input process-checkbox" value="' + data + '" />';
                    }
                },
                { data: 'processName', render: function (d) { return escapeHtml(d || ''); } },
                { data: 'processId', render: function (d) { return '<code>' + escapeHtml(d || '') + '</code>'; } },
                { data: 'arrivalTime' },
                { data: 'burstTime' },
                { data: 'deadline' },
                { data: 'priority' },
                {
                    data: 'status',
                    render: function (data) {
                        if (data === 'Pending') return '<span class="badge bg-warning text-dark">Pending</span>';
                        if (data === 'Running') return '<span class="badge bg-success">Running</span>';
                        if (data === 'Completed') return '<span class="badge bg-info">Completed</span>';
                        if (data === 'Missed') return '<span class="badge bg-danger">Missed</span>';
                        return '<span class="badge bg-secondary">' + escapeHtml(data) + '</span>';
                    }
                },
                {
                    data: 'createdByName',
                    defaultContent: 'N/A',
                    render: function (data) { return escapeHtml(data || 'N/A'); }
                },
                {
                    data: 'createdAt',
                    render: function (data) {
                        if (!data) return '';
                        var d = new Date(data);
                        return d.toLocaleDateString('en-US', { month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    }
                },
                {
                    data: 'id',
                    orderable: false,
                    searchable: false,
                    width: '120px',
                    render: function (data) {
                        return '<div class="btn-group btn-group-sm">' +
                            '<a href="' + baseUrl + 'Details/' + data + '" class="btn btn-outline-info" title="Details"><i class="fas fa-eye"></i></a>' +
                            '<button type="button" class="btn btn-outline-danger btn-delete-process" data-id="' + data + '" title="Delete"><i class="fas fa-trash"></i></button>' +
                            '</div>';
                    }
                }
            ],
            order: [[9, 'desc']],
            language: {
                emptyTable: 'No processes found.',
                zeroRecords: 'No matching processes found.',
                processing: '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>'
            },
            drawCallback: function () {
                syncCheckboxes();
            }
        });
    }

    function getSortColumn(d) {
        if (!d.order || !d.order.length) return 'createdAt';
        var colIdx = d.order[0].column;
        var map = { 1: 'processName', 3: 'arrivalTime', 4: 'burstTime', 7: 'status', 9: 'createdAt' };
        return map[colIdx] || 'createdAt';
    }

    function getSortDirection(d) {
        if (!d.order || !d.order.length) return 'desc';
        return d.order[0].dir === 'asc' ? 'ASC' : 'DESC';
    }

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    function updateShowingInfo() {
        var info = table.page.info();
        if (info) {
            $('#showingInfo').text('Showing ' + (info.start + 1) + '-' + info.end + ' of ' + info.recordsTotal + ' processes');
        }
    }

    function updateExportLinks() {
        var p = function (id) { return encodeURIComponent($('#' + id).val() || ''); };
        var base = '@Url.Action("ExportExcel")?searchTerm=' + p('searchInput') + '&userFilter=' + p('userFilter') + '&statusFilter=' + p('statusFilter') + '&dateFrom=' + p('dateFrom') + '&dateTo=' + p('dateTo');
        var basePdf = '@Url.Action("ExportPdf")?searchTerm=' + p('searchInput') + '&userFilter=' + p('userFilter') + '&statusFilter=' + p('statusFilter') + '&dateFrom=' + p('dateFrom') + '&dateTo=' + p('dateTo');
        $('#btnExportExcel').attr('href', base);
        $('#btnExportPdf').attr('href', basePdf);
    }

    function syncCheckboxes() {
        var anyChecked = false;
        $('#processesBody .process-checkbox').each(function () {
            if (selectedIds.has(this.value)) { this.checked = true; anyChecked = true; }
            else { this.checked = false; }
        });
        $('#selectAll').prop('checked', anyChecked && $('#processesBody .process-checkbox:checked').length === $('#processesBody .process-checkbox').length);
        updateSelectedCount();
    }

    function updateSelectedCount() {
        var count = selectedIds.size;
        $('#selectedCount').text(count);
        $('#btnBulkDelete').prop('disabled', count === 0);
    }

    // Load filter options
    $.get('@Url.Action("GetFilterOptions")', function (res) {
        if (res.users) {
            res.users.forEach(function (u) {
                $('#userFilter').append('<option value="' + u.value + '">' + escapeHtml(u.label) + '</option>');
            });
        }
        if (res.statuses) {
            res.statuses.forEach(function (s) {
                $('#statusFilter').append('<option value="' + s.value + '">' + escapeHtml(s.label) + '</option>');
            });
        }
    });

    // Search / Filter
    $('#btnSearch').on('click', function () { selectedIds.clear(); table.ajax.reload(null, true); });
    $('#searchInput, #dateFrom, #dateTo, #userFilter, #statusFilter').on('keyup change', function (e) {
        if (e.type === 'keyup' && e.key !== 'Enter') return;
        selectedIds.clear();
        table.ajax.reload(null, true);
    });

    // Select All
    $('#selectAll').on('change', function () {
        var checked = this.checked;
        $('#processesBody .process-checkbox').each(function () {
            this.checked = checked;
            if (checked) selectedIds.add(this.value); else selectedIds.delete(this.value);
        });
        updateSelectedCount();
    });

    $('#processesBody').on('change', '.process-checkbox', function () {
        if (this.checked) selectedIds.add(this.value); else selectedIds.delete(this.value);
        var total = $('#processesBody .process-checkbox').length;
        var checked = $('#processesBody .process-checkbox:checked').length;
        $('#selectAll').prop('checked', total > 0 && checked === total);
        updateSelectedCount();
    });

    // Bulk Delete
    var token = $('input[name="__RequestVerificationToken"]').first().val() || '';
    var bulkUrl = '@Url.Action("BulkAction")';

    $('#btnBulkDelete').on('click', function () {
        if (!selectedIds.size) return;
        Swal.fire({
            title: 'Delete ' + selectedIds.size + ' process(es)?',
            text: 'This will soft-delete the selected processes.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Yes, delete them!'
        }).then(function (result) {
            if (result.isConfirmed) {
                Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: function () { Swal.showLoading(); } });
                $.ajax({
                    url: bulkUrl + '?action=delete',
                    type: 'POST',
                    data: { selectedIds: Array.from(selectedIds), __RequestVerificationToken: token },
                    traditional: true
                }).done(function (res) {
                    selectedIds.clear();
                    table.ajax.reload(null, true);
                    Swal.fire('Deleted!', res.message || 'Processes deleted.', 'success');
                }).fail(function () { Swal.fire('Error', 'Failed to delete processes.', 'error'); });
            }
        });
    });

    // Individual delete
    $('#processesTable').on('click', '.btn-delete-process', function () {
        var id = $(this).data('id');
        Swal.fire({
            title: 'Delete this process?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            confirmButtonText: 'Delete'
        }).then(function (result) {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Delete")/' + id,
                    type: 'POST',
                    data: { __RequestVerificationToken: token }
                }).done(function () {
                    table.ajax.reload(null, true);
                    Swal.fire('Deleted!', 'Process deleted.', 'success');
                }).fail(function () { Swal.fire('Error', 'Failed to delete process.', 'error'); });
            }
        });
    });

    initTable();
})();
</script>
}
